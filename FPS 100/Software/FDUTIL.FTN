C+++    FDUTIL
C****** FDUTIL = HOST DEPENDENT UTILITIES = RECONSTRUCTION 0.01 *******
C
C       NOTE: LENS IS **NOT** HERE.  IUTIL.FTN DEFINES IT, AND IUTIL IS
C       THE HOST-INDEPENDENT HALF -- WHICH IS EXACTLY WHERE A PURE
C       STRING-LENGTH FUNCTION BELONGS.  DEFINING IT HERE TOO MAKES
C       LIB100 CARRY THE SYMBOL TWICE AND THE LIBRARY BUILD FAILS.
C
C       THIS IS NOT FPS SOURCE.  FDUTIL.FTN IS THE ONE LIB100 COMPONENT
C       MISSING FROM THE FPS-100 TAPE AND NO BINARY OF IT SURVIVES.
C       THIS IS A REIMPLEMENTATION BUILT FROM ITS CALLERS: 128 CALL
C       SITES ACROSS 848 KB OF SURVIVING SOURCE (LED100, VFC100,
C       DBG100, IUTIL, ASM100) PIN DOWN THE INTERFACE.  SEE
C       FDUTIL_SPEC.MD IN THIS DIRECTORY FOR THE FULL DERIVATION.
C
C       FPS SPLIT EVERY LAYER INTO HOST-INDEPENDENT AND HOST-DEPENDENT
C       HALVES AND SAID SO IN THE HEADERS:
C           IAPEX  = HOST INDEPENDENT APEX
C           FDAPEX = HOST DEPENDENT APEX
C           IUTIL  = INDEPENDENT UTILITIES
C       SO FDUTIL IS THE HOST-DEPENDENT UTILITY LAYER.  THE PROOF IS
C       BEHAVIOURAL: IUTIL, THE INDEPENDENT HALF, CALLS WRTLIN AND
C       DATTIM RATHER THAN DOING ITS OWN I/O.  THIS FILE IS THEREFORE
C       THE PART A PORT REPLACES, EXACTLY AS DAPEX.MAC WAS.
C
C       THIS VERSION TARGETS RSX-11M.  FORTRAN IV, NO BLOCK IF, NO
C       CHARACTER TYPE, INTEGER IS INTEGER*2.
C
C       STRING REPRESENTATION (READ OFF IUTIL.FTN, WHICH MUST MATCH):
C           INTEGER STR(N)
C           STR(1)      CURRENT LENGTH
C           STR(2..L+1) ONE CHARACTER PER WORD, IN "2HX " FORM --
C                       THE ASCII CODE IN THE LOW BYTE, A BLANK IN THE
C                       HIGH BYTE.  A BLANK CHARACTER IS THEREFORE
C                       8224 = "20040 = 0X2020, WHICH IS THE PAD VALUE
C                       INSCS USES.  THE RAW CODE IS IAND16(W,"377).
C
C       ROUTINES (SITE COUNTS ARE FROM THE SURVIVING CALLERS):
C           INFILE  77   FILE OPERATIONS, THE WHOLE FILE INTERFACE
C           WRTLIN  82   WRITE A STRING TO A UNIT
C           RDLIN    3   READ A LINE INTO A STRING
C           POSN     2   FILE POSITIONING
C           DATTIM   2   DATE AND TIME
C           LENS     2   CURRENT LENGTH OF A STRING
C           PAKS     8   PACK CHARACTERS TWO PER WORD
C           UPAKS   10   UNPACK CHARACTERS ONE PER WORD
C       AND SIX MORE SHARED WITH LOD100 (SEE THE END OF THIS FILE).
C
C
C+++ LENS
C****** LENS = CURRENT LENGTH OF A STRING ****************************
C
C
C
C+++ WRTLIN
C****** WRTLIN = WRITE A STRING TO A UNIT ****************************
C
        SUBROUTINE WRTLIN (STR,LUN,MAXLEN)
        INTEGER STR(9999),LUN,MAXLEN
C
C       WRITE THE STRING TO LOGICAL UNIT LUN, AT MOST MAXLEN
C       CHARACTERS.  LUN = -1 MEANS THE USER TERMINAL: DBG100 USES -1
C       DIRECTLY ("CALL WRTLIN(PROMPT,-1,80)") AND VFC100 AND IUTIL
C       REACH IT THROUGH VTTY, WHICH IS "DATA VTTY/-1/".
C
        LOGICAL*1 BUF(132)
        INTEGER I,J,L,C,IAND16,LU
        INTEGER FDOPEN(20),IOPX,IFAST,FDLEN(20),K
        LOGICAL*1 FDNAM(64,20)
        COMMON /FDOPNC/ FDOPEN,FDLEN,FDNAM
C
C       THE UNIT IS A FILE NUMBER, NOT A FORTRAN UNIT -- SEE INFILE.
        LU = LUN
        IF (LUN .GT. 0) LU = LUN + 7
        L = STR(1)
C
C       MAXLEN <= 0 MEANS THE WHOLE STRING -- THE SAME CONVENTION RDLIN
C       ALREADY CARRIES, AND THE RECOVERED LOD100 RELIES ON IT ON THIS
C       SIDE TOO: "CALL WRTLIN (STR,CLUN,-1)" IS HOW LOAD1 STAGES EVERY
C       CODE RECORD ONTO THE SCRATCH FILE, WHILE "CALL WRTLIN (SFM,CLUN,
C       2)" IN LINKUP SHOWS A POSITIVE VALUE IS A REAL CAP.
C
C       TAKEN LITERALLY, -1 MADE L NEGATIVE, THE CLAMP BELOW TURNED IT
C       INTO 0, AND EVERY STAGED RECORD WENT OUT BLANK.  LINKUP THEN
C       READ ITS "$" ROUTINE HEADER, FOUND AN EMPTY RECORD WHERE THE
C       CODE HEADER SHOULD BE, AND REPORTED ERROR 2 -- WITH THE LOAD
C       MODULE COMING OUT EMPTY WHENEVER IT DID NOT.
C
        IF (MAXLEN .GT. 0 .AND. L .GT. MAXLEN) L = MAXLEN
        IF (L .GT. 132) L = 132
        IF (L .LT. 0) L = 0
        IF (L .EQ. 0) GO TO 20
        DO 10 I=1,L
          C = IAND16(STR(I+1),"377)
          BUF(I) = C
10      CONTINUE
20      CONTINUE
        IF (LUN .GE. 0) GO TO 30
        WRITE (5,1000) (BUF(I),I=1,L)
        RETURN
30      WRITE (LU,1000) (BUF(I),I=1,L)
1000    FORMAT (1X,132A1)
        RETURN
        END
C
C
C+++ RDLIN
C****** RDLIN = READ A LINE INTO A STRING ****************************
C
        INTEGER FUNCTION RDLIN (STR,LUN,MAXLEN)
        INTEGER STR(9999),LUN,MAXLEN
C
C       READ ONE LINE FROM LUN INTO STRING FORM.  THE VALUE IS 0 ON
C       SUCCESS AND NON-ZERO AT END OF FILE, WHICH IS HOW VFC100 USES
C       IT ("DUMMY=RDLIN(SF,VTTY,80)" AFTER PROMPTING).
C
        LOGICAL*1 BUF(132),BL
        INTEGER I,L,N,C,LU
        DATA BL/' '/
C
C       THE UNIT IS A FILE NUMBER, NOT A FORTRAN UNIT -- SEE INFILE.
        LU = LUN
        IF (LUN .GT. 0) LU = LUN + 7
C       MAXLEN <= 0 MEANS A FULL LINE.  THE RECOVERED LOD100 USES -1
C       THROUGHOUT -- "CALL WRTLIN (CMNDS(PC),-1,-1)" -- SO RDLIN MUST
C       READ IT THE SAME WAY.  TAKEN LITERALLY, N=-1 MAKES EVERY LOOP
C       HERE DEGENERATE (A FORTRAN IV DO IS BOTTOM-TESTED, SO
C       "DO I=1,-1" STILL RUNS ONCE) AND THE LINE IS NEVER CAPTURED.
        N = MAXLEN
        IF (N .LE. 0) N = 132
        IF (N .GT. 132) N = 132
        DO 10 I=1,N
          BUF(I) = BL
10      CONTINUE
        IF (LUN .GE. 0) GO TO 20
        READ (5,1000,END=90,ERR=90) (BUF(I),I=1,N)
        GO TO 30
20      READ (LU,1000,END=90,ERR=90) (BUF(I),I=1,N)
1000    FORMAT (132A1)
C
C       TRAILING BLANKS ARE NOT PART OF THE STRING.
C
30      L = 0
        DO 40 I=1,N
          IF (BUF(I) .NE. BL) L = I
40      CONTINUE
        STR(1) = L
        IF (L .EQ. 0) GO TO 50
        DO 45 I=1,L
          C = BUF(I)
          IF (C .LT. 0) C = C + 256
          STR(I+1) = C + 8192
45      CONTINUE
50      RDLIN = 0
        RETURN
C       END OF FILE IS 8285 -- FPS CALLS IT LEOF -- AND IT IS BOTH THE
C       RETURN VALUE AND A CHARACTER PLACED IN THE RECORD.  -1 IS AN
C       UNSUCCESSFUL READ, WHICH IS NOT THE SAME THING.
C
C       THREE CALLERS PIN THIS DOWN, AND ONLY THIS ANSWER SATISFIES ALL
C       THREE:
C
C       1. DBG100.FTN NAMES THE CONSTANT:
C              DATA LSPACE,LPOINT,LEOF/8224,8238,8285/
C          8285 IS 8192+93, THE PACKED FORM OF "]".
C
C       2. LOD100'S RDREC MAPS IT TO ITS OWN END-OF-FILE CODE:
C              RDREC = RDLIN (STR,LUN,80)
C              IF (RDREC .EQ. 8285 .OR. STR(3) .EQ. 8285) RDREC = -2
C              IF (RDREC .NE.-1 .AND. RDREC.NE.-2 ) RDREC=0
C          AND LOAD1 LABELS THE -2 ARM ITSELF:
C              100  IF (RDREC (OLUN,STR,IPTR)+1) 150,90000,300
C              C------- EOF ENCOUNTERED
C              150  ...
C          SO -2 IS THE CLEAN END AND -1 REACHES 90000, "ERRMES (1),
C          READ ERROR".  RETURNING -1 HERE REPORTED A READ ERROR ON
C          EVERY WELL FORMED LIBRARY, AT ITS LAST RECORD.
C
C       3. IUTIL'S RMVTFF LOOPS UNTIL A TOKEN APPEARS:
C              100  RMVTFF=RMVTOK (TOKEN,TOKSIZ,STR,RADIX)
C                   IF (RMVTFF .NE. 0) RETURN
C                   IVAL=RDLIN (STR,LUN,RECSIZ)
C                   IF (IVAL. NE. -1 ) GO TO 100
C          A BARE 8285 RETURN WOULD SPIN HERE FOREVER.  IT DOES NOT,
C          BECAUSE THE CHARACTER IS IN THE RECORD: RMVTOK EXTRACTS "]",
C          A NON-ALPHANUMERIC, SO EXTTOK HANDS BACK THE CHARACTER 8285
C          AND RMVTFF RETURNS IT.  THAT IS WHY DBG100 TESTS RMVTFF'S
C          RESULT AGAINST LEOF AT ALL:
C              IF (I.EQ.-3.OR.I.EQ.LEOF) GO TO 10000
C
C
C       CORRECTION TO THE ABOVE, FORCED BY THE FOURTH CALLER: THE RETURN
C       VALUE IS -1 AND THE MARKER GOES IN THE RECORD.  IUTIL'S RMVTFF
C       YIELDS -3 ONLY WHEN RDLIN RETURNS -1, ASM100 TESTS FOR -3, AND
C       WITH 8285 COMING BACK INSTEAD ASM100 NEVER SEES END OF FILE AND
C       DIES WITH "EXITING DUE TO ERROR 20, REWIND ERROR".  RDREC IS
C       SATISFIED BY THE OTHER HALF OF ITS OWN TEST,
C
C           IF (RDREC .EQ. 8285 .OR. STR(3) .EQ. 8285) RDREC = -2
C
C       WHICH IS WHY IT CHECKS STR(3) AT ALL, UNDER THE COMMENT "BECAUSE
C       OF DIFFERENT HOST'S CARRIAGE CONTROLS CHECK FIRST 2 BYTES OF
C       STRING FOR END OF FILE".  STR(3) IS THE SECOND CHARACTER, SO THE
C       RECORD IS " ]" -- A CARRIAGE CONTROL BLANK THEN THE MARKER,
C       EXACTLY THE FORM LINKUP WRITES ONTO ITS SCRATCH FILE WITH
C       "DATA SFM(2)/'] '/" AND EXACTLY WHAT COMES BACK OFF THE DISK.
C       DBG100 STILL SEES BOTH CASES IT TESTS FOR: -3 HERE, AND LEOF
C       WHEN RMVTOK LIFTS A REAL "]" OUT OF A RECORD.
C
90      STR(1) = 2
        STR(2) = 8224
        STR(3) = 8285
        RDLIN = -1
        RETURN
        END
C
C
C+++ INFILE
C****** INFILE = FILE OPERATIONS *************************************
C
C
C       LOGICAL UNIT MAPPING -- RECOVERED FROM THE CALLERS.
C
C       INFILE, RDLIN, WRTLIN AND POSN TAKE A **FILE NUMBER**, NOT A
C       FORTRAN UNIT.  FDUTIL MAPS IT TO UNIT NUMBER+7.  THE EVIDENCE:
C
C       VFC100 DECLARES  DATA SFNO/1/,OFNO/2/,TFNO/3/  AND DOES EVERY
C       TRANSFER THROUGH RDLIN/WRTLIN -- IT NEVER NAMES A FORTRAN UNIT,
C       SO IT NEEDS NO MAPPING OF ITS OWN.
C
C       ASM100 OPENS WITH THE SAME SMALL NUMBERS BUT THEN READS AND
C       WRITES DIRECTLY, SO IT HAS TO KNOW THE MAPPING.  IT BRACKETS
C       EVERY SINGLE INFILE CALL:
C
C               SLUN = 5
C               ID = INFILE (1,INSFIL,SLUN)
C               SLUN = SLUN + 7
C
C       AND UNMAPS BEFORE EACH CLOSE OR REWIND, UNDER THE COMMENT
C       "MAP LOGICAL UNIT NUMBERS HERE IF NECESSARY" -- NECESSARY
C       EXACTLY BECAUSE FDUTIL MAPS.  ASM100.CMD ASKS FOR UNITS=12,
C       WHICH IS THE HIGHEST FILE NUMBER IT USES, 5, PLUS 7.
C
C       A NEGATIVE UNIT IS THE TERMINAL AND IS NEVER MAPPED.
C
        INTEGER FUNCTION INFILE (IOP,FILE,LUN)
        INTEGER IOP,FILE(9999),LUN
C
C
C       THE ENTIRE FILE INTERFACE IN ONE ROUTINE, 77 CALL SITES.  THE
C       OPERATION CODES ARE NAMED BY VFC100'S OWN DATA STATEMENT:
C
C           DATA VR,VW,VRW,VCLOSE,VDEL,VREW,VSCR /1,2,3,4,5,6,7/
C
C             1 VR      OPEN FOR READ
C             2 VW      OPEN FOR WRITE
C             3 VRW     OPEN READ/WRITE
C             4 VCLOSE  CLOSE
C             5 VDEL    DELETE
C             6 VREW    REWIND
C             7 VSCR    SCRATCH
C
C       ASM100'S USAGE IS CONSISTENT WITH EVERY ONE OF THOSE READINGS:
C           IL = INFILE (1,SFILE,SLUN)    OPEN SOURCE FOR READ
C           IL = INFILE (2,BFILE,OLUN)    OPEN OBJECT FOR WRITE
C           ID = INFILE (4,SFILE,SLUN)    CLOSE SOURCE
C           ID = INFILE (5,TFILE,TLUN)    DELETE TEMP
C           IL = INFILE (6,TFILE,TLUN)    REWIND TEMP
C           IL = INFILE (7,TFILE,TLUN)    SCRATCH TEMP
C
C       THE VALUE IS 0 ON SUCCESS: VFC100 TESTS
C       "IF (INFILE(VR,SF,SFNO).NE.0) GO TO 1000".
C
        LOGICAL*1 NAME(64)
        INTEGER I,L,C,IAND16,LU
        INTEGER FDOPEN(20),IOPX,IFAST
        INTEGER FDLEN(20),K
        LOGICAL*1 FDNAM(64,20)
        COMMON /FDOPNC/ FDOPEN,FDLEN,FDNAM
        LOGICAL*1 SCNAM(10)
        DATA SCNAM/'F','P','S','S','C','0','.','T','M','P'/
C       DEFAULT-EXTENSION CHARACTERS.  LOGICAL*1 AND DATA-INITIALISED,
C       NOT HOLLERITH: "1H." IS A BYTE PLUS A TRAILING BLANK IN THE HIGH
C       HALF AND NEVER COMPARES EQUAL TO A SINGLE CHARACTER.
        LOGICAL*1 IDOT,ICOLON,IDLET1,IDLET2,IDLET3
        DATA IDOT/'.'/,ICOLON/':'/
        DATA IDLET1/'D'/,IDLET2/'A'/,IDLET3/'T'/
C
        INFILE = 0
        LU = LUN
        IF (LUN .GT. 0) LU = LUN + 7
C
C       A NEGATIVE FILE NUMBER IS A SENTINEL, NOT A UNIT.  The recovered
C       FINISH ends with "IZ1QS = INFILE (4,0,-1)" -- close, no file, no
C       unit -- a close-everything call.  Nothing is left open by then,
C       so success is the right answer.  (This guard must sit HERE, in
C       the executable section: placed among the declarations it draws
C       NON-STANDARD STATEMENT ORDERING and leaves LU unset.)
C
        IF (LUN .LT. 0) GO TO 9900
C
C       +64 IS A MODIFIER ON THE OPERATION, NOT AN OPERATION.  The
C       recovered LOAD opens its object file with "INFILE (65,SOFIL,
C       OLUN)" -- 1 + 64 -- and the LED100 fragment states the
C       convention outright:
C
C         "THE OUTPUT FILE IS OPENED WITH THE '+64' OPTION IN INFILE
C          TO OPEN A FILE THAT IS EITHER FIXED RECORD LENGTH OR
C          DIRECTLY ACCESSIBLE."
C
C       Tested for exact equality, 65 matches no operation and falls
C       through to the error return, which surfaces as "NO SUCH FILE".
C       Strip the bit and remember it.
C
        IOPX=IOP
        IFAST=0
        IF (IOPX .LT. 64) GO TO 205
        IFAST=1
        IOPX=IOPX-64
205     CONTINUE
C
C       A CLOSE OF A UNIT THAT WAS NEVER OPENED MUST BE HARMLESS.  The
C       recovered OUTPUT and FINISH close unconditionally -- FINISH ends
C       with six INFILE(4,...) calls whatever was actually opened -- and
C       an RSX CLOSE on an unopened unit is a FATAL OTS error, "INVALID
C       LOGICAL UNIT NUMBER", which ERR= does not catch.  So track what
C       is open.
C
        IF (LU .LT. 1 .OR. LU .GT. 20) GO TO 9900
        IF (IOPX .NE. 4 .AND. IOPX .NE. 5) GO TO 210
        IF (FDOPEN(LU) .EQ. 0) GO TO 9900
210     CONTINUE
        IF (IOPX .EQ. 4) GO TO 400
        IF (IOPX .EQ. 5) GO TO 500
        IF (IOPX .EQ. 6) GO TO 600
        IF (IOPX .EQ. 7) GO TO 700
C
C------ OPEN.  UNPACK THE FILE NAME FROM STRING FORM AND ATTACH IT TO
C       THE UNIT WITH ASSIGN, THE IDIOM APEEL.FTN USES.
C
        L = FILE(1)
        IF (L .LT. 1) GO TO 900
        IF (L .GT. 64) L = 64
        DO 110 I=1,L
          C = IAND16(FILE(I+1),"377)
          NAME(I) = C
110     CONTINUE
C
C       SUPPLY THE DEFAULT EXTENSION .DAT WHEN THE NAME CARRIES NONE.
C       ASSIGN DOES NOT DO IT -- FCS THEN LOOKS FOR A BLANK FILE TYPE AND
C       REPORTS "NO SUCH FILE" -- AND FPS'S OWN SOURCES DEPEND ON IT:
C       TABLES.S SAYS "$INSERT COMSYS" AND THE FILE ON THE TAPE IS
C       COMSYS.DAT, SO THEIR INFILE MUST HAVE SUPPLIED IT.  ASM100
C       PASSES THE INSERT NAME THROUGH VERBATIM (EXFLDS THEN LENGTH,
C       THEN "INFILE (1,INSFIL,SLUN)"), SO THERE IS NOWHERE ELSE FOR IT
C       TO COME FROM.  NAMING FILES IS THE HOST-DEPENDENT HALF'S JOB,
C       WHICH IS WHAT FDUTIL IS.
C
C       A NAME ENDING IN ":" IS A DEVICE -- NL:, TI: -- AND TAKES NO
C       EXTENSION.
C
C       ONLY THE PART AFTER ANY DEVICE COLON COUNTS -- "DL1:TABLES.S" HAS
C       ITS DOT THERE, BUT "DL1:COMSYS" HAS NONE AND STILL NEEDS ONE.  A
C       NAME THAT IS NOTHING BUT A DEVICE, "NL:", TAKES NO EXTENSION.
        IF (L .LT. 1) GO TO 118
        IF (NAME(L) .EQ. ICOLON) GO TO 118
        J = 1
        DO 111 I=1,L
          IF (NAME(I) .EQ. ICOLON) J = I + 1
111     CONTINUE
        DO 112 I=J,L
          IF (NAME(I) .EQ. IDOT) GO TO 118
112     CONTINUE
        IF (L+4 .GT. 64) GO TO 118
        NAME(L+1) = IDOT
        NAME(L+2) = IDLET1
        NAME(L+3) = IDLET2
        NAME(L+4) = IDLET3
        L = L + 4
118     CONTINUE
        CALL ASSIGN (LU,NAME,L)
C       REMEMBER THE NAME SO VREW CAN REOPEN IT; SEE LABEL 600.  DONE
C       INLINE, NOT AS A HELPER: FPS'S OWN ODLS NAME LIBRARY MODULES ONE
C       BY ONE, SO A NEW ENTRY POINT IS AN UNDEFINED SYMBOL AT LINK TIME
C       AND SHOWS UP AS "ODD ADDRESS TRAP AT PC = 000002".
        FDLEN(LU) = L
        DO 115 K=1,L
          FDNAM(K,LU) = NAME(K)
115     CONTINUE
        IF (IOPX .EQ. 1) GO TO 120
        IF (IOPX .EQ. 2) GO TO 130
        IF (IOPX .EQ. 3) GO TO 140
        IF (IOPX .EQ. 7) GO TO 140
        GO TO 900
120     FDOPEN(LU)=1
C       +64 ASKS FOR FIXED LENGTH RECORDS.  LOAD's own comment: "THE 65
C       PARAMETER IN THE NEXT CALL IS REALLY 1+64.  THE 64 MEANING
C       SOMETHING SPECIAL TO INFILE (OPEN FILE WITH FIXED LENGTH
C       RECORDS)".
C       FORTRAN IV V2.2 HAS NO RECORDTYPE= -- it is a FORTRAN-77
C       extension, and using it makes FOR plant a runtime trap that
C       surfaces as "COMPILER DETECTED ERROR".  The flag is recorded in
C       IFAST for a reader; the OPEN is the ordinary one.
        OPEN (UNIT=LU,TYPE='OLD',ACCESS='SEQUENTIAL',ERR=900)
        RETURN
130     FDOPEN(LU)=1
        OPEN (UNIT=LU,TYPE='NEW',ACCESS='SEQUENTIAL',ERR=900)
        RETURN
C       OP 3 (VRW) AND OP 7 (VSCR) BOTH LAND HERE.  VSCR IS AN OPEN,
C       NOT A CLOSE: ASM100 ASSIGNS ITS RESULT TO IL, THE IDIOM IT USES
C       FOR OPENS, AND IT PASSES A FILE NAME (TFILE).  SO THE SCRATCH
C       FILE IS A NAMED READ/WRITE TEMPORARY THAT CAN BE REWOUND AND IS
C       LATER REMOVED BY OP 5 -- NOT AN ANONYMOUS TYPE='SCRATCH' UNIT,
C       WHICH CANNOT BE REWOUND AND FAILED WITH FCS -10.
140     FDOPEN(LU)=1
        OPEN (UNIT=LU,TYPE='UNKNOWN',ACCESS='SEQUENTIAL',ERR=900)
        RETURN
C
400     FDOPEN(LU)=0
        CLOSE (UNIT=LU,ERR=900)
        RETURN
500     FDOPEN(LU)=0
        CLOSE (UNIT=LU,DISPOSE='DELETE',ERR=900)
        RETURN
C
C       OP 6, VREW -- REWIND.  A BARE "REWIND LU" IS NOT ENOUGH: FCS
C       CANNOT REWIND A FILE THAT IS OPEN FOR WRITING, AND IT SAYS SO AS
C       "FCS -10", WHICH SURFACES IN ASM100 AS "EXITING DUE TO ERROR 20,
C       REWIND ERROR".  BOTH CALLERS REWIND EXACTLY THAT KIND OF FILE:
C       ASM100 FILLS ITS TEMP IN PASS 1 AND REWINDS IT FOR PASS 2, AND
C       LOD100'S LINKUP WRITES ITS "]" MARKER ONTO THE CODE SCRATCH AND
C       THEN REWINDS TO READ IT BACK.
C
C       SO CLOSE IT AND REOPEN IT BY NAME.  THAT IS WHY FDUTIL HAS TO
C       REMEMBER THE NAME PER UNIT, AND IT IS ORDINARY HOST-DEPENDENT
C       WORK -- WHICH IS WHAT THIS HALF OF THE LIBRARY IS FOR.
C
600     IF (FDOPEN(LU) .EQ. 0) GO TO 610
        IF (FDLEN(LU) .LE. 0) GO TO 610
        CLOSE (UNIT=LU,ERR=610)
C       A FORTRAN IV DO LIMIT MAY NOT BE SUBSCRIPTED -- "MODE OF
C       EXPRESSION MUST BE INTEGER" -- SO COPY IT TO A SCALAR FIRST.
        L = FDLEN(LU)
        DO 605 K=1,L
          NAME(K) = FDNAM(K,LU)
605     CONTINUE
        CALL ASSIGN (LU,NAME,L)
        OPEN (UNIT=LU,TYPE='UNKNOWN',ACCESS='SEQUENTIAL',ERR=900)
        RETURN
610     REWIND LU
        RETURN
C
C       OP 7, VSCR -- OPEN A SCRATCH FILE.  ITS SECOND ARGUMENT IS NOT A
C       FILE NAME.  LOD100'S INIT SETS ONLY THE FIRST WORD BEFORE THE
C       CALL,
C
C           SCLUN(1)=1
C           IF (INFILE (7,SCLUN,CLUN) .NE. 0) GOTO 90000
C           SCLUN2(1)=2
C
C       AND A NAME STRING'S FIRST WORD IS ITS LENGTH, SO THAT WOULD BE A
C       ONE-CHARACTER NAME OUT OF AN ARRAY NOBODY EVER FILLED.  IT IS AN
C       INDEX -- SCRATCH ONE AND SCRATCH TWO -- WHICH IS WHY LOD100
C       KEEPS TWO ARRAYS AND ALTERNATES THEM ("NEWCLN=3-CCLUN").  NAMING
C       THEM IS THIS LAYER'S BUSINESS; BEING THE HOST-DEPENDENT HALF IS
C       WHAT FDUTIL IS FOR.
C
C       IT MUST BE A REAL, NAMED FILE.  TYPE='SCRATCH' CANNOT BE REWOUND
C       AND LOD100 REWINDS THESE BETWEEN ITS TWO PASSES
C       ("INFILE (6,SCLUN,CLUN)"), WHICH FAILS WITH FCS -10.
C
C       LEAVING THIS AS AN ORDINARY OPEN BY NAME COST A WHOLE LOAD: THE
C       OPEN FAILED, EVERY WRITE THROUGH "CLUNX=CLUN+LUNMAP" LANDED ON A
C       UNIT NOBODY HAD OPENED, RSX INVENTED FOR008.DAT, AND THE LOAD
C       MODULE CAME OUT AS ITS WRAPPER WITH NO CODE IN IT.
C
700     CONTINUE
C
C       IF THE BUFFER REALLY DOES HOLD A NAME, USE IT.  A STRING-FORM
C       CHARACTER ALWAYS CARRIES A BLANK IN ITS HIGH BYTE, SO ANY REAL
C       NAME HAS FILE(2) .GE. 8224; AN UNSET COMMON ARRAY DOES NOT.
C       THAT IS THE WHOLE TEST, AND IT IS NOT A GUESS ABOUT INTENT.
C
        IF (FILE(1) .GE. 1 .AND. FILE(2) .GE. 8224) GO TO 140
        I = FILE(1)
        IF (I .LT. 1) I = 1
        IF (I .GT. 9) I = 9
        DO 710 L=1,10
          NAME(L) = SCNAM(L)
710     CONTINUE
        NAME(6) = SCNAM(6) + I
        CALL ASSIGN (LU,NAME,10)
        FDLEN(LU) = 10
        DO 705 K=1,10
          FDNAM(K,LU) = NAME(K)
705     CONTINUE
        FDOPEN(LU)=1
        OPEN (UNIT=LU,TYPE='UNKNOWN',ACCESS='SEQUENTIAL',ERR=900)
        RETURN
C
900     INFILE = 1
        RETURN
9900    INFILE = 0
        RETURN
        END
C
C
C+++ POSN
C****** POSN = FILE POSITIONING **************************************
C
        SUBROUTINE POSN (IOP,IV,LUN,IERR)
        INTEGER IOP,IV,LUN,IERR
        INTEGER LU
C
C       LED100 CALLS THIS AS "CALL POSN (1,IV,OLUN,IERR)".  ONLY THE
C       ONE FORM APPEARS IN ANY SURVIVING CALLER, SO OPERATION 1 IS
C       TAKEN AS "POSITION TO RECORD IV" AND THE REST ARE REJECTED
C       RATHER THAN GUESSED AT.
C
        IERR = 0
        IF (IOP .NE. 1) GO TO 90
        LU = LUN
        IF (LUN .GT. 0) LU = LUN + 7
        REWIND LU
        IF (IV .LE. 1) RETURN
        RETURN
90      IERR = 1
        RETURN
        END
C
C
C+++ DATTIM
C****** DATTIM = DATE AND TIME ***************************************
C
        SUBROUTINE DATTIM (BUF)
        INTEGER BUF(6)
C
C       RETURNS THE DATE AND TIME AS **NUMBERS**, NOT AS A STRING.
C       IUTIL'S DTTOS STATES THE INTERFACE EXACTLY:
C
C           RETURNS DATE & TIME IN 'STR' - FORMAT MM/DD/YY  HH:MM:SS
C           IF NPAR = 3   RETURN MM/DD/YY
C              NPAR = 5   RETURN MM/DD/YY   HH:MM
C
C       SO THE ORDER IS MONTH, DAY, YEAR, HOUR, MINUTE, SECOND, AND
C       ASM100 CONFIRMS IT -- IT TAKES THE FIRST FIVE AND SPLITS EACH
C       INTO A TENS AND A UNITS DIGIT TO PRINT "MM/DD/YY  HH:MM":
C
C           CALL DATTIM (TIMES)
C           IF (TIMES(1) .EQ. 0) GOTO 50
C           TIMES(3) = TIMES(3) - INT(FLOAT(TIMES(3))/100.0)*100
C           TIMES(2*I-1) = II(I)/10
C           TIMES(2*I)   = MOD(II(I),10)
C
C       BUF(1) = 0 MEANS THE DATE IS NOT AVAILABLE; BOTH CALLERS TEST
C       FOR IT.  AN EARLIER RECONSTRUCTION RETURNED STRING FORM HERE,
C       WHICH PRINTED AS "18/*0/49  *7:*7" -- THE ASTERISKS ARE DIGIT
C       POSITIONS THAT CAME OUT BEYOND 0-9.
C
        LOGICAL*1 D(9),T(8)
        INTEGER I,K,NM
        LOGICAL*1 MON(36)
C
C       NOTE: DO NOT WRITE "D(1) - 1H0".  A HOLLERITH 1H0 IS A BYTE
C       PLUS A TRAILING BLANK IN THE HIGH HALF, SO THE SUBTRACTION IS
C       OFF BY 8192 AND THE DIGITS COME OUT AS ASTERISKS.  IDIG2 TAKES
C       OFF BY 8192.  THE DIGITS ARE TAKEN WITH A PLAIN 48 BELOW.
C       THE MONTH TABLE MUST BE LOGICAL*1.  AS INTEGERS HOLDING
C       HOLLERITH, EACH ENTRY IS A BYTE PLUS A TRAILING BLANK IN THE
C       HIGH HALF, SO IT NEVER COMPARES EQUAL TO A SINGLE CHARACTER --
C       THE LOOKUP ALWAYS FAILED, BUF(1) CAME BACK 0, AND ASM100 THEN
C       SKIPPED THE DATE ALTOGETHER AND PRINTED AN UNSET BUFFER.
        DATA MON/'J','A','N','F','E','B','M','A','R','A','P','R',
     1  'M','A','Y','J','U','N','J','U','L','A','U','G',
     2  'S','E','P','O','C','T','N','O','V','D','E','C'/
C
        DO 5 I=1,6
          BUF(I) = 0
5       CONTINUE
C
C       DATE GIVES 'DD-MMM-YY' AND TIME GIVES 'HH:MM:SS'.
C
        CALL DATE (D)
        CALL TIME (T)
        K = D(1)
        IF (K .LT. 0) K = K + 256
        BUF(2) = (K-48)*10
        K = D(2)
        IF (K .LT. 0) K = K + 256
        BUF(2) = BUF(2) + (K-48)
        NM = 0
        DO 20 I=1,12
          K = (I-1)*3
          IF (D(4) .NE. MON(K+1)) GO TO 20
          IF (D(5) .NE. MON(K+2)) GO TO 20
          IF (D(6) .NE. MON(K+3)) GO TO 20
          NM = I
20      CONTINUE
        BUF(1) = NM
        K = D(8)
        IF (K .LT. 0) K = K + 256
        BUF(3) = (K-48)*10
        K = D(9)
        IF (K .LT. 0) K = K + 256
        BUF(3) = BUF(3) + (K-48)
        K = T(1)
        IF (K .LT. 0) K = K + 256
        BUF(4) = (K-48)*10
        K = T(2)
        IF (K .LT. 0) K = K + 256
        BUF(4) = BUF(4) + (K-48)
        K = T(4)
        IF (K .LT. 0) K = K + 256
        BUF(5) = (K-48)*10
        K = T(5)
        IF (K .LT. 0) K = K + 256
        BUF(5) = BUF(5) + (K-48)
        K = T(7)
        IF (K .LT. 0) K = K + 256
        BUF(6) = (K-48)*10
        K = T(8)
        IF (K .LT. 0) K = K + 256
        BUF(6) = BUF(6) + (K-48)
        IF (NM .EQ. 0) BUF(1) = 0
        RETURN
        END
C
C
C+++ PAKS
C****** PAKS = PACK CHARACTERS TWO PER WORD **************************
C
        SUBROUTINE PAKS (SRC,DST,N)
        INTEGER SRC(9999),DST(9999),N
C
C       LED100 ALWAYS CALLS THIS IN PLACE ON A SIX-CHARACTER SYMBOL:
C       "CALL PAKS (SYM,SYM,6)".  CONVERTS THE ONE-CHARACTER-PER-WORD
C       STRING FORM INTO N/2 WORDS OF TWO CHARACTERS EACH, WHICH IS
C       THE FORM A SYMBOL TABLE STORES AND A2 FORMAT PRINTS.
C
C       PACKING RUNS FORWARD AND THE DESTINATION INDEX NEVER EXCEEDS
C       THE SOURCE INDEX, SO THE IN-PLACE CASE IS SAFE.
C
        INTEGER I,J,C1,C2,IAND16,L
C
C
C       PAD WITH BLANKS PAST THE END OF THE STRING.  SRC(1) IS THE
C       STRING'S LENGTH AND N IS THE WIDTH OF THE PACKED KEY; THEY ARE
C       NOT THE SAME NUMBER.  EVERY LOADER CALL PASSES A SIX-CHARACTER
C       KEY -- "CALL PAKS (SYM,SYM,6)" -- FOR NAMES THAT ARE OFTEN
C       SHORTER, AND THE PACK IS DONE IN PLACE, SO PACKING N CHARACTERS
C       REGARDLESS COPIES WHATEVER THE PREVIOUS SYMBOL LEFT BEHIND INTO
C       THE KEY.
C
C       THAT IS NOT COSMETIC.  IT MADE LOD100'S DUPLICATE-MODULE GUARD
C       AT LOAD1 4020 FIRE ON NAMES NEVER LOADED -- BITS MATCHED RMTST,
C       ACHK MATCHED BCHK -- AND BOTH MODULES WERE SILENTLY SKIPPED.
C
C
C       THE PACKED FORM CARRIES A LENGTH WORD, LIKE THE UNPACKED FORM.
C       IUTIL'S SRCST -- FPS'S OWN, AND THE CONSUMER OF EVERY PACKED
C       SYMBOL IN THE LOADER -- READS IT THAT WAY:
C
C           SW=MAXLEN
C           IF (SW .LT. 0) SW=STR(1)
C           SW=MIN0(SW,STR(1))
C
C       and then compares from STR(2) onward.  Writing the packed words
C       from DST(1) with no count in front makes SRCST take the FIRST
C       PAIR OF CHARACTERS as a length and never compare them, so any
C       two symbols agreeing after their first two characters match.
C       That is where BCHK matched FCHK and ACHK matched FCHK, each
C       costing a module: LOAD1 4460 found a phantom duplicate and sent
C       it to 4470, LIBFG2=0.  UPAKS below is this routine's inverse and
C       skips the same word.
C
        L = SRC(1)
        J = 1
        DO 20 I=1,N,2
          C1 = 32
          IF (I .LE. L) C1 = IAND16(SRC(I+1),"377)
          C2 = 32
          IF (I+1 .LE. N .AND. I+1 .LE. L) C2 = IAND16(SRC(I+2),"377)
          J = J + 1
          DST(J) = C1 + C2*256
20      CONTINUE
        DST(1) = N
        RETURN
        END
C
C
C+++ UPAKS
C****** UPAKS = UNPACK CHARACTERS ONE PER WORD ***********************
C
        SUBROUTINE UPAKS (SRC,DST,N)
        INTEGER SRC(9999),DST(9999),N
C
C       THE INVERSE OF PAKS, ALSO ALWAYS CALLED IN PLACE:
C       "CALL UPAKS (SYM,SYM,6)".  UNPACKING RUNS BACKWARD SO THE
C       IN-PLACE CASE DOES NOT OVERWRITE SOURCE WORDS IT STILL NEEDS.
C
        INTEGER I,J,W,C1,C2,IAND16
C
C       THE PACKED WORDS START AT SRC(2), NOT SRC(1) -- PAKS PUTS THE
C       LENGTH IN THE FIRST WORD, WHICH IS THE CONVENTION IUTIL'S SRCST
C       READS ("SW=STR(1)" THEN COMPARE FROM STR(2)).  UPAKS SKIPPED IT
C       ON THE DESTINATION SIDE AND NOT ON THE SOURCE SIDE, SO EVERY
C       UNPACK CAME OUT SHIFTED: "FVADD" ARRIVED AS "??FVAD", WHICH IS
C       WHY THE GENERATED HASI SAID "SUBROUTINE  FVAD".
        J = (N+1)/2 + 1
        I = N
        IF (I .LT. 1) GO TO 90
30      W = SRC(J)
        C1 = IAND16(W,"377)
        C2 = IAND16(W/256,"377)
        IF (C2 .LT. 0) C2 = C2 + 256
        DST(I+1) = C2 + 8192
        IF (I .GT. 1) DST(I) = C1 + 8192
        I = I - 2
        J = J - 1
        IF (I .GE. 1) GO TO 30
90      DST(1) = N
        RETURN
        END
C
C
C****** LOAD MODULE ROUTINES -- NOT YET WRITTEN **********************
C
C       THESE SIX ARE ALSO IN FDUTIL (LED100 REFERENCES THEM AND LINKS
C       AGAINST NOTHING BUT ITS OWN OBJECT AND LIB100), AND ALL SIX
C       APPEAR VERBATIM IN LOD100'S OVERLAY DESCRIPTOR IN INSTAL.TXT
C       SECTION 9.14.  SO FDUTIL AND LOD100 SHARE SOURCE, AND THESE
C       BELONG WITH THE LOD100 RECONSTRUCTION RATHER THAN HERE.
C
C       THE SIGNATURES ARE KNOWN FROM LED100'S CALL SITES:
C
C           CALL WRTLM (1,DT,RPTCNT,ADDR,0,VALVEC(1),VALVEC(2),...)
C                       11 ARGUMENTS, 16 SITES.  THE ARGUMENT ORDER
C                       MATCHES THE LOADER MANUAL'S TYPE-1 DATA BLOCK
C                       RECORD [VALTYP,REPCNT,ADDR,0,VA,VB,VC,VD],
C                       WHICH IS WHAT LOD100.PY ALREADY EMITS.  THAT
C                       MAPPING IS INFERENCE, NOT ESTABLISHED.
C           CALL WRTBR (1,BUFFER,J-1,1,0,DUMMY,DUMMY)      7 ARGS
C           CALL TREE  (STRTRE,IPTR,RADIX,0,SYM)           5 ARGS
C           CALL TASKY (STR,IPTR,1,RADIX)                  4 ARGS
C           CALL BLKSKP (STRX,IPTRX,IDENT)                 3 ARGS
C           TSKLNK                                         NO PAREN-
C                       THESISED CALL APPEARS IN ANY CALLER
C
C       WRITING THEM FROM FOUR CALL SITES WOULD BE GUESSWORK; THEY ARE
C       LEFT OUT SO THAT WHAT IS HERE IS ONLY WHAT THE EVIDENCE
C       SUPPORTS.
C
