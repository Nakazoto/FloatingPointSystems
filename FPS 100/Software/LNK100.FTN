C+++    MAIN
C****** LNK100 = FPS-100 OBJECT MODULE LINKER = RECONSTRUCTION 0.01
C
C       THIS IS NOT FPS SOURCE.  THE ORIGINAL LNK100.FTN IS LOST: IT IS
C       NOT ON THE FPS-100 SOFTWARE TAPE AND NO BINARY OF IT SURVIVES.
C       THIS IS A REIMPLEMENTATION WRITTEN FROM THE PUBLISHED SPEC:
C
C         FPS-100 LINKER (LNK100) REFERENCE MANUAL, 860-7441-000, OCT 1979
C           CHAPTER 2  COMMAND SET AND DIALOGUE
C           CHAPTER 3  OBJECT MODULE FORMAT
C           CHAPTER 4  E AND A COMMAND OUTPUT
C
C       AND CROSS-CHECKED AGAINST LNK100.PY IN THIS REPOSITORY, WHICH
C       IMPLEMENTS THE SAME ALGORITHMS AND IS VALIDATED AGAINST THE NINE
C       APO LIBRARIES FROM THE FPS-100 ARCHIVE.
C
C       STATUS: COMPILES CLEAN (0 ERRORS, 1 WARNING).  AN EARLIER BUILD
C       LINKED VADD.APO AND ITS E-FORMAT OUTPUT WAS DIFFED AGAINST
C       LNK100.PY, WHICH FOUND THAT FORWARD REFERENCES WERE NOT BEING
C       RELOCATED -- FIXED BY THE FIXUP TABLE APPLIED IN EMTFIL.  THAT
C       FIX IS **NOT YET VERIFIED**: THE TASK BUILD NOW FAILS WITH
C       ALLOCATION FAILURE ON THE ODS1MAKE VOLUME, WHICH IS A LIMITATION
C       OF THAT TOOL RATHER THAN OF THIS SOURCE.
C
C       WRITTEN IN FORTRAN IV (FORTRAN 66) FOR RSX-11M.  NO BLOCK IF,
C       NO CHARACTER TYPE, SIX-CHARACTER NAMES, INTEGER IS INTEGER*2.
C       BUILD WITH LNK10.CMD (RECOVERED FROM INSTAL.TXT SECTION 9.13).
C
C       COMMANDS (MANUAL SECTION 2.3 THROUGH 2.13):
C         L (FILE)   LOAD OBJECT MODULE OR LIBRARY
C         S (FILE)   LIST GLOBAL SYMBOL TABLE
C         U (FILE)   LIST UNDEFINED GLOBAL SYMBOLS
C         B (LOC)    SET BASE ADDRESS FOR NEXT MODULE
C         R          RESET LINKER TO INITIAL STATE
C         F (NAME)   FORCE LOADING OF A LIBRARY MODULE
C         M          REPORT HIGHEST ADDRESS LOADED
C         E (FILE)   END, EMIT LOAD MODULE FOR SIM100/DBG100
C         A (FILE)   END, EMIT HOST FORTRAN SOURCE FOR APX100
C         N (RADIX)  SET I/O RADIX TO 8, 10 OR 16
C         X          EXIT
C
        PROGRAM LNK100
C
C                                                                       LNKCOM
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        INTEGER NARG
        LOGICAL*1 CMD,ARG(40)
        LOGICAL*1 TTBUF(80)
        INTEGER IDS
        LOGICAL*1 CL,CS,CU,CB,CR,CF,CM,CE,CA,CN,CX
        DATA CL/'L'/,CS/'S'/,CU/'U'/,CB/'B'/,CR/'R'/,CF/'F'/
        DATA CM/'M'/,CE/'E'/,CA/'A'/,CN/'N'/,CX/'X'/
        LOGICAL*1 CBL
        DATA CBL/' '/
C
C------ INITIALIZE
C
        ITTI = 5
        ITTO = 6
        IOBJ = 1
        IOUT = 2
        IRADIX = 8
        CALL RESET
C
        WRITE (ITTO,1000)
1000    FORMAT (' LNK100  REL. 0.01 , RECONSTRUCTION')
C
C------ COMMAND LINE MODE.
C
C       NOTE: THIS IS AN EXTENSION, NOT RECOVERED BEHAVIOUR.  THE LNK100
C       MANUAL DOCUMENTS ONLY THE INTERACTIVE DIALOGUE (CHAPTER 2), AND
C       INSTAL.TXT SECTION 6.2.1.2 SHOWS LNK100 BEING DRIVEN THAT WAY
C       ("RUN LNK100" FOLLOWED BY L / S / M / E / X AT THE * PROMPT).
C
C       BUT AN INTERACTIVE-ONLY LINKER CANNOT SIT IN A BUILD PIPELINE
C       EXCEPT THROUGH AN INDIRECT COMMAND FILE.  FPS SOLVED THIS FOR
C       APEEL BY INSTALLING IT AS ...APE AND READING THE MCR COMMAND
C       LINE (SEE APEEL.FTN, AND ITS USE IN APL100.CMD AS
C       "APE 0,AMLLIB.APO").  WE FOLLOW THAT HOUSE IDIOM HERE:
C
C           LNK (OUTFILE)=(INFILE)
C
C       LOADS INFILE, ENDS TO OUTFILE AND EXITS.  WITH NO COMMAND LINE
C       LNK100 FALLS THROUGH TO THE DOCUMENTED INTERACTIVE DIALOGUE.
C
        CALL GETMCR (TTBUF,IDS)
        IF (IDS .LE. 4) GO TO 100
        CALL BATCH (TTBUF,IDS)
        GO TO 900
C
C------ COMMAND LOOP.  AN ASTERISK IS THE READY PROMPT (SECTION 2.1);
C       AN UNRECOGNIZED COMMAND PRODUCES A QUESTION MARK.
C
100     CONTINUE
        CALL GETCMD (CMD,ARG,NARG)
C       A BARE RETURN AT THE PROMPT IS NOT AN ERROR; JUST RE-PROMPT.
        IF (CMD .EQ. CBL) GO TO 100
C
        IF (CMD .EQ. CL) GO TO 200
        IF (CMD .EQ. CS) GO TO 210
        IF (CMD .EQ. CU) GO TO 220
        IF (CMD .EQ. CB) GO TO 230
        IF (CMD .EQ. CR) GO TO 240
        IF (CMD .EQ. CF) GO TO 250
        IF (CMD .EQ. CM) GO TO 260
        IF (CMD .EQ. CE) GO TO 270
        IF (CMD .EQ. CA) GO TO 280
        IF (CMD .EQ. CN) GO TO 290
        IF (CMD .EQ. CX) GO TO 900
C
C       ILLEGAL COMMAND
        WRITE (ITTO,1010)
1010    FORMAT (' ?')
        GO TO 100
C
C------ L : LOAD (SECTION 2.3)
200     CALL LOAD (ARG,NARG)
        GO TO 100
C
C------ S : SYMBOLS (SECTION 2.4)
210     CALL SYMLST (ARG,NARG)
        GO TO 100
C
C------ U : UNDEFINED (SECTION 2.5)
220     CALL UNDLST (ARG,NARG)
        GO TO 100
C
C------ B : NEXT BASE (SECTION 2.6)
230     CALL SETBAS (ARG,NARG)
        GO TO 100
C
C------ R : RESET (SECTION 2.7)
240     CALL RESET
        GO TO 100
C
C------ F : FORCE (SECTION 2.8)
250     CALL FORCE (ARG,NARG)
        GO TO 100
C
C------ M : MEMORY (SECTION 2.9)
260     CALL MEMORY
        GO TO 100
C
C------ E : END, SIM100/DBG100 LOAD MODULE (SECTION 2.10)
270     CALL ENDMOD (ARG,NARG,0)
        GO TO 100
C
C------ A : END WITH ASSEMBLY CODE (SECTION 2.11)
280     CALL ENDMOD (ARG,NARG,1)
        GO TO 100
C
C------ N : NUMBER RADIX (SECTION 2.12)
290     CALL SETRAD (ARG,NARG)
        GO TO 100
C
C------ X : EXIT (SECTION 2.13).  NO OUTPUT IS PRODUCED.
900     WRITE (ITTO,1020)
1020    FORMAT (' END LNK100')
        CALL EXIT
        END
C
C
C****** RESET = REINITIALIZE THE LINKER = SECTION 2.7 *****************
C
        SUBROUTINE RESET
C
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        INTEGER I,J
C
C       THE SYMBOL TABLE IS CLEARED, PREVIOUSLY LOADED PROGRAMS ARE
C       DISREGARDED, AND THE NEXT LOCATION IS SET TO ZERO.
C
        NSYM = 0
        HIGH = 0
        BASE = 0
        NEXTLC = 0
        NUNDEF = 0
        FROZEN = 0
        LODCNT = 0
        NCODE = 0
        NFIX = 0
        DO 10 I=1,3
          FIRSTE(I) = 0
10      CONTINUE
        DO 20 J=1,2400
          DO 15 I=1,4
            CODE(I,J) = 0
15        CONTINUE
20      CONTINUE
        RETURN
        END
C
C
C****** MEMORY = REPORT HIGHEST ADDRESS LOADED = SECTION 2.9 **********
C
        SUBROUTINE MEMORY
C
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        WRITE (ITTO,1000) HIGH
1000    FORMAT (' HIGH = ',O6)
        RETURN
        END
C
C
C****** SETBAS = SET BASE ADDRESS FOR NEXT MODULE = SECTION 2.6 *******
C
        SUBROUTINE SETBAS (ARG,NARG)
C
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        INTEGER IVAL
C
        CALL NUMIN (ARG,NARG,IVAL)
        BASE = IVAL
        NEXTLC = IVAL
        RETURN
        END
C
C
C****** SETRAD = SET I/O RADIX = SECTION 2.12 *************************
C
        SUBROUTINE SETRAD (ARG,NARG)
C
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        INTEGER IVAL
C
C       ONLY 8, 10 AND 16 ARE LEGAL.
C
        CALL NUMIN (ARG,NARG,IVAL)
        IF (IVAL .EQ. 8)  IRADIX = 8
        IF (IVAL .EQ. 10) IRADIX = 10
        IF (IVAL .EQ. 16) IRADIX = 16
        IF (IVAL .EQ. 8)  RETURN
        IF (IVAL .EQ. 10) RETURN
        IF (IVAL .EQ. 16) RETURN
        WRITE (ITTO,1000)
1000    FORMAT (' ?')
        RETURN
        END
C
C
C****** SYMLST = LIST THE GLOBAL SYMBOL TABLE = SECTION 2.4 ***********
C
        SUBROUTINE SYMLST (ARG,NARG)
C
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        INTEGER I,LUN
C
C       THE LISTING GOES TO THE FILE NAMED ON THE COMMAND, OR TO THE
C       TERMINAL.  FORMAT IS PER SECTION 2.4.
C
        CALL OPNOUT (ARG,NARG,LUN)
        WRITE (LUN,1000) HIGH
1000    FORMAT (' HIGH = ',O6)
        WRITE (LUN,1010)
1010    FORMAT (/' SYMBOL TABLE'/' SYMBOL          VALUE')
        IF (NSYM .LE. 0) GO TO 90
        DO 50 I=1,NSYM
          IF (SYMFLG(I) .EQ. 0) GO TO 40
          WRITE (LUN,1020) SYMNAM(1,I),SYMNAM(2,I),SYMNAM(3,I),SYMVAL(I)
1020      FORMAT (1X,3A2,8X,O6)
          GO TO 50
40        WRITE (LUN,1030) SYMNAM(1,I),SYMNAM(2,I),SYMNAM(3,I),SYMVAL(I)
1030      FORMAT (1X,3A2,8X,O6,'  U')
50      CONTINUE
90      CALL CLSOUT (LUN)
        RETURN
        END
C
C
C****** UNDLST = LIST UNDEFINED GLOBAL SYMBOLS = SECTION 2.5 **********
C
        SUBROUTINE UNDLST (ARG,NARG)
C
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        INTEGER I,LUN
C
C       NNNNNN IS THE LOCATION OF THE LAST INSTRUCTION THAT REFERENCED
C       THE SYMBOL, WHICH IS WHAT SYMVAL HOLDS WHILE STILL UNDEFINED.
C
        CALL OPNOUT (ARG,NARG,LUN)
        IF (NSYM .LE. 0) GO TO 90
        DO 50 I=1,NSYM
          IF (SYMFLG(I) .NE. 0) GO TO 50
          WRITE (LUN,1000) SYMNAM(1,I),SYMNAM(2,I),SYMNAM(3,I),SYMVAL(I)
1000      FORMAT (1X,3A2,8X,O6,'  U')
50      CONTINUE
90      CALL CLSOUT (LUN)
        RETURN
        END
C
C
C****** FORCE = ENTER A SYMBOL AS EXTERNAL = SECTION 2.8 **************
C
        SUBROUTINE FORCE (ARG,NARG)
C
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        INTEGER NAME(3),IDX
C
C       F ENTERS THE NAME INTO THE SYMBOL TABLE AS AN EXTERNAL, WHICH
C       CAUSES A LATER LIBRARY LOAD TO PULL IN THE MODULE DEFINING IT.
C       IF NO MODULE HAS BEEN LOADED YET, THIS ALSO NAMES THE HOST
C       SOURCE OUTPUT (SECTION 2.3).
C
        CALL ARGNAM (ARG,NARG,NAME)
        CALL SYMLU (NAME,IDX,1)
        IF (LODCNT .NE. 0) RETURN
        IF (FIRSTE(1) .NE. 0) RETURN
        FIRSTE(1) = NAME(1)
        FIRSTE(2) = NAME(2)
        FIRSTE(3) = NAME(3)
        RETURN
        END
C
C
C****** SYMLU = SYMBOL TABLE LOOKUP AND INSERT ************************
C
        SUBROUTINE SYMLU (NAME,IDX,MODE)
C
C       MODE 0 = LOOK UP ONLY, IDX=0 IF ABSENT
C       MODE 1 = LOOK UP, INSERTING AS UNDEFINED IF ABSENT
C
        INTEGER NAME(3),IDX,MODE
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C
        INTEGER I
C
        IDX = 0
        IF (NSYM .LE. 0) GO TO 30
        DO 20 I=1,NSYM
          IF (SYMNAM(1,I) .NE. NAME(1)) GO TO 20
          IF (SYMNAM(2,I) .NE. NAME(2)) GO TO 20
          IF (SYMNAM(3,I) .NE. NAME(3)) GO TO 20
          IDX = I
          RETURN
20      CONTINUE
30      IF (MODE .EQ. 0) RETURN
        IF (NSYM .GE. 600) GO TO 80
        NSYM = NSYM + 1
        SYMNAM(1,NSYM) = NAME(1)
        SYMNAM(2,NSYM) = NAME(2)
        SYMNAM(3,NSYM) = NAME(3)
        SYMVAL(NSYM) = 0
        SYMFLG(NSYM) = 0
        NUNDEF = NUNDEF + 1
        IDX = NSYM
        RETURN
80      WRITE (ITTO,1000)
1000    FORMAT (' SYMBOL TABLE OVERFLOW')
        RETURN
        END
C
C
C****** OBJECT MODULE READER AND LOAD MODULE EMITTER ******************
C
C       APO OBJECT FORMAT, LNK100 MANUAL CHAPTER 3.  ALL NUMBERS OCTAL.
C       A BLOCK HEADER IS ANY LINE CONTAINING "***"; THE FIRST NUMBER ON
C       IT IS THE BLOCK TYPE AND THE SECOND, WHERE PRESENT, IS THE COUNT
C       OF DATA RECORDS THAT FOLLOW.
C
C         6  ***LSB      1  ***END       3  ***TITLE
C         4 C ***ENTRY   5 C ***EXT     13 C ***AENTRY
C         0 C L ***CODE  7  ***LEB      12 C ***FPB
C
C       ONLY RELOCATION TYPE 5, EXTERNAL REFERENCE, IS PROCESSED -- SAID
C       TWICE IN SECTION 3.2.  IT PATCHES THE LOW 16 BITS OF THE 64-BIT
C       WORD, WHICH IS THE VALUE FIELD (BITS 48-63), I.E. CODE WORD 4.
C
        SUBROUTINE LODFIL (LUN)
C
        INTEGER LUN
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
        LOGICAL*1 LINE(80),NBUF(80)
        INTEGER V(16),NV,BTYPE,ICNT,IL,I,J,K,IDX
        INTEGER NAME(3),MODBAS,NEXTRA,EXTNAM(3,40),NEXT,FIXBAS
        INTEGER STAR3,ENTIDX(60),NENT
C
        MODBAS = NEXTLC
        NEXT = 0
        NENT = 0
        FIXBAS = NFIX
C
10      READ (LUN,900,END=800) LINE
900     FORMAT (80A1)
        CALL STARS (LINE,STAR3)
        IF (STAR3 .EQ. 0) GO TO 10
        CALL GETNUM (LINE,STAR3-1,V,NV,16)
        IF (NV .LE. 0) GO TO 10
        BTYPE = V(1)
        ICNT = 0
        IL = 0
        IF (NV .GE. 2) ICNT = V(2)
        IF (NV .GE. 3) IL = V(3)
C
        IF (BTYPE .EQ. 3) GO TO 100
        IF (BTYPE .EQ. 4) GO TO 200
        IF (BTYPE .EQ. 5) GO TO 300
        IF (BTYPE .EQ. 0) GO TO 400
        IF (BTYPE .EQ. 1) GO TO 500
C       AENTRY IS BLOCK TYPE 13 **OCTAL** = 11 DECIMAL.  THE MANUAL
C       GIVES EVERY BLOCK TYPE IN OCTAL (SECTION 3.1: "THE OCTAL BLOCK
C       TYPE NUMBER IS IN PARENTHESES") AND GETNUM PARSES OCTAL, SO A
C       DECIMAL 13 HERE NEVER MATCHES AND EVERY AENTRY BLOCK IS SKIPPED
C       -- WHICH LEAVES ITS SYMBOLS UNDEFINED.  TYPES 0,1,3,4,5,6,7 READ
C       THE SAME IN BOTH BASES, WHICH IS WHY ONLY THIS ONE BIT.
        IF (BTYPE .EQ. 11) GO TO 200
        IF (BTYPE .EQ. 6) GO TO 10
        IF (BTYPE .EQ. 7) GO TO 800
C       ANY OTHER BLOCK (FPB, DBDB, DBIB) IS SKIPPED WITH ITS RECORDS.
        IF (ICNT .LE. 0) GO TO 10
        DO 20 I=1,ICNT
          READ (LUN,900,END=800) LINE
20      CONTINUE
        GO TO 10
C
C------ TITLE: THE MODULE NAME IS ON THE FOLLOWING LINE.
100     READ (LUN,900,END=800) LINE
        CALL PACK6 (LINE,1,NAME)
        LODCNT = LODCNT + 1
        IF (FIRSTE(1) .NE. 0) GO TO 10
        FIRSTE(1) = NAME(1)
        FIRSTE(2) = NAME(2)
        FIRSTE(3) = NAME(3)
        GO TO 10
C
C------ ENTRY / AENTRY: NAME VALUE TYPE PARAMNUM.  THE VALUE IS RELATIVE
C       TO THE START OF THE ROUTINE, SO ADD THE MODULE BASE.
200     IF (ICNT .LE. 0) GO TO 10
        DO 210 I=1,ICNT
          READ (LUN,900,END=800) LINE
          CALL PACK6 (LINE,1,NAME)
C
C         PARSE THE NUMBERS FROM COLUMN 7.  THE NAME OCCUPIES COLUMNS
C         1-6 AND MAY CONTAIN DIGITS -- FUN1, ADV2, XFFT4, SET24B,
C         VINDX2, TRED2 AND IMTQL2 ALL DO -- AND GETNUM OVER THE WHOLE
C         LINE TAKES THOSE FOR THE ADDRESS.  THE SYMBOL THEN RESOLVES
C         TO MODBAS PLUS THE DIGITS IN ITS OWN NAME: FUN1 THROUGH FUN4
C         CAME OUT ONE TO FOUR HIGH, AND SET24B TWENTY HIGH.
C
          DO 201 J=1,74
            NBUF(J) = LINE(J+6)
201       CONTINUE
          CALL GETNUM (NBUF,74,V,NV,16)
          CALL SYMLU (NAME,IDX,1)
          IF (IDX .LE. 0) GO TO 210
          IF (SYMFLG(IDX) .NE. 0) GO TO 205
          NUNDEF = NUNDEF - 1
205       SYMFLG(IDX) = 1
          SYMVAL(IDX) = MODBAS
          IF (NV .GE. 1) SYMVAL(IDX) = MODBAS + V(1)
C         REMEMBER IT: IF THIS MODULE TURNS OUT TO EMIT NO CODE AT
C         ALL, THE VALUE IS ABSOLUTE AND MUST NOT CARRY MODBAS.
          IF (NENT .GE. 60) GO TO 210
          NENT = NENT + 1
          ENTIDX(NENT) = IDX
210     CONTINUE
        GO TO 10
C
C------ EXT: A LIST OF NAMES.  THE RELOCATION ARG IS A ONE-BASED INDEX
C       INTO THIS LIST, SO THE ORDER MATTERS.
300     IF (ICNT .LE. 0) GO TO 10
        DO 310 I=1,ICNT
          READ (LUN,900,END=800) LINE
          CALL PACK6 (LINE,1,NAME)
          IF (NEXT .GE. 40) GO TO 310
          NEXT = NEXT + 1
          EXTNAM(1,NEXT) = NAME(1)
          EXTNAM(2,NEXT) = NAME(2)
          EXTNAM(3,NEXT) = NAME(3)
          CALL SYMLU (NAME,IDX,1)
310     CONTINUE
C
C       TURN THIS MODULE'S PENDING EXT INDICES INTO SYMBOL INDICES.
C
        IF (NFIX .LE. FIXBAS) GO TO 10
        DO 320 I=FIXBAS+1,NFIX
          IDX = -FIXSYM(I)
          IF (IDX .LT. 1) GO TO 320
          IF (IDX .GT. NEXT) GO TO 320
          NAME(1) = EXTNAM(1,IDX)
          NAME(2) = EXTNAM(2,IDX)
          NAME(3) = EXTNAM(3,IDX)
          CALL SYMLU (NAME,J,1)
          FIXSYM(I) = J
320     CONTINUE
        GO TO 10
C
C------ CODE: ICNT DATA RECORDS OF FOUR OCTAL WORDS, EACH OPTIONALLY
C       FOLLOWED BY (FLDDES,TYPE,ARG) TRIPLES.
400     IF (ICNT .LE. 0) GO TO 10
        DO 450 I=1,ICNT
          READ (LUN,900,END=800) LINE
          CALL GETNUM (LINE,80,V,NV,16)
          IF (NV .LT. 4) GO TO 450
          IF (NCODE .GE. 2400) GO TO 440
          NCODE = NCODE + 1
          DO 410 J=1,4
            CODE(J,NCODE) = V(J)
410       CONTINUE
C         RELOCATION TRIPLES START AT FIELD 5.
          K = 5
420       IF (K+2 .GT. NV) GO TO 445
          IF (V(K+1) .NE. 5) GO TO 430
          IDX = V(K+2)
          IF (IDX .LT. 1) GO TO 430
C         RECORD THE RAW EXT INDEX, NOT A SYMBOL.  THE ***EXT BLOCK
C         COMES AFTER ***CODE IN THE FILE (MANUAL SECTION 3.1 GIVES THE
C         ORDER AS TITLE, AENTRY, ENTRY, CODE, EXT, END), SO THE NAME
C         THIS INDEX SELECTS IS NOT KNOWN YET.  THE EXT HANDLER TURNS
C         THESE INTO SYMBOL TABLE INDICES; EMTFIL THEN APPLIES THEM,
C         WHICH IS WHAT THE MANUAL MEANS BY THE E OR A COMMAND
C         "FREEZING" THE LINKS (SECTION 2.10).
          IF (NFIX .GE. 1000) GO TO 428
          NFIX = NFIX + 1
          FIXWRD(NFIX) = NCODE
          FIXSYM(NFIX) = -IDX
428       CONTINUE
430       K = K + 3
          GO TO 420
440       WRITE (ITTO,910)
910       FORMAT (' PROGRAM STORE OVERFLOW')
445       CONTINUE
450     CONTINUE
        NEXTLC = NEXTLC + ICNT
        IF (NEXTLC .GT. HIGH) HIGH = NEXTLC - 1
        GO TO 10
C
C------ END: CONSUMES THE TRAILING NAME LINE, THEN THE NEXT MODULE MAY
C       FOLLOW IN THE SAME FILE (A LIBRARY).
500     READ (LUN,900,END=800) LINE
C
C       A MODULE WITH NO ***CODE BLOCK OCCUPIES NO PROGRAM STORE AND
C       ITS ***ENTRY RECORDS CARRY ABSOLUTE ADDRESSES.  THAT IS WHAT
C       SYMLIB IS: 66 MODULES OF PURE $EQU, E.G.
C
C              4      1      ***ENTRY
C         !DIV    10000      0      0
C
C       ADDING THE MODULE BASE GAVE !ONE = 4146 INSTEAD OF 4097 AS
C       SOON AS ANY CODE-BEARING MODULE WAS LINKED AHEAD OF SYMLIB.
C       THE AP THEN READ THE WRONG TABLE MEMORY WORD FOR ITS LOOP
C       COUNTER AND VADD STORED ONE ELEMENT INSTEAD OF THREE.
C
        IF (NEXTLC .NE. MODBAS) GO TO 510
        IF (NENT .LE. 0) GO TO 510
        DO 505 I=1,NENT
          SYMVAL(ENTIDX(I)) = SYMVAL(ENTIDX(I)) - MODBAS
505     CONTINUE
510     CONTINUE
        MODBAS = NEXTLC
        NEXT = 0
        NENT = 0
        FIXBAS = NFIX
        GO TO 10
C
800     RETURN
        END
C
C
C****** STARS = LOCATE "***" IN A LINE, 0 IF ABSENT *******************
C
        SUBROUTINE STARS (LINE,IPOS)
        LOGICAL*1 LINE(80),AST
        INTEGER IPOS,I
        DATA AST/'*'/
        IPOS = 0
        DO 10 I=1,78
          IF (LINE(I) .NE. AST) GO TO 10
          IF (LINE(I+1) .NE. AST) GO TO 10
          IF (LINE(I+2) .NE. AST) GO TO 10
          IPOS = I
          RETURN
10      CONTINUE
        RETURN
        END
C
C
C****** GETNUM = EXTRACT OCTAL NUMBERS FROM A LINE *******************
C
C       A LEADING "*" ON A CODE RECORD MARKS RELOCATION AND IS SKIPPED.
C
        SUBROUTINE GETNUM (LINE,NCH,V,NV,MAXV)
        LOGICAL*1 LINE(80),BL,AST,ZERO,SEVEN
        INTEGER NCH,V(16),NV,MAXV,I,D,ACC,INNUM
        DATA BL/' '/,AST/'*'/,ZERO/'0'/,SEVEN/'7'/
        NV = 0
        INNUM = 0
        ACC = 0
        DO 30 I=1,NCH
          IF (LINE(I) .EQ. AST) GO TO 30
          IF (LINE(I) .LT. ZERO) GO TO 20
          IF (LINE(I) .GT. SEVEN) GO TO 20
          D = LINE(I) - ZERO
C         A 16-BIT OCTAL FIELD RUNS TO 177777, WHICH DOES NOT FIT A
C         SIGNED INTEGER*2 -- THE PLAIN ACC*8+D TRAPS WITH "INTEGER
C         OVERFLOW" ON THE LAST DIGIT.  FOLD THE TOP BIT IN BY HAND:
C         (ACC-4096)*8+D-32768 IS THE TWO'S COMPLEMENT OF THE VALUE WE
C         WANT AND EVERY INTERMEDIATE STAYS IN RANGE.
          IF (ACC .GE. 4096) GO TO 12
          ACC = ACC * 8 + D
          GO TO 14
C         32768 IS NOT A VALID INTEGER*2 LITERAL, SO SUBTRACT IT IN TWO
C         STEPS; EVERY INTERMEDIATE THEN STAYS IN RANGE.
12        ACC = ACC - 4096
          ACC = ACC * 8 + D
          ACC = ACC - 32767
          ACC = ACC - 1
14        INNUM = 1
          GO TO 30
20        IF (INNUM .EQ. 0) GO TO 30
          IF (NV .GE. MAXV) GO TO 25
          NV = NV + 1
          V(NV) = ACC
25        ACC = 0
          INNUM = 0
30      CONTINUE
        IF (INNUM .EQ. 0) RETURN
        IF (NV .GE. MAXV) RETURN
        NV = NV + 1
        V(NV) = ACC
        RETURN
        END
C
C
C****** PACK6 = PACK SIX CHARACTERS INTO THREE WORDS *****************
C
        SUBROUTINE PACK6 (LINE,IST,NAME)
        LOGICAL*1 LINE(80)
        INTEGER IST,NAME(3),I,J,K,C1,C2
        DO 20 I=1,3
          J = IST + 2*I - 2
          K = J + 1
          C1 = LINE(J)
          C2 = LINE(K)
          IF (C1 .LT. 0) C1 = C1 + 256
          IF (C2 .LT. 0) C2 = C2 + 256
          NAME(I) = C1 + C2*256
20      CONTINUE
        RETURN
        END
C
C
C****** EMTFIL = WRITE THE LOAD MODULE ********************************
C
C       MODE 0, THE E COMMAND: A CORE IMAGE FOR SIM100 AND DBG100
C       (SECTION 2.10).  ONE LINE PER PROGRAM STORE WORD, FOUR OCTAL
C       16-BIT FIELDS, WHICH IS THE SAME PRESENTATION THE ***CODE BLOCK
C       USES AND WHAT DBG100 READS BACK.
C
C       MODE 1, THE A COMMAND: HOST FORTRAN FOR APX100 (SECTION 2.11) --
C       A SUBROUTINE WHOSE BODY IS DATA STATEMENTS, NAMED FOR THE FIRST
C       ENTRY POINT DEFINED.
C
        SUBROUTINE EMTFIL (LUN,MODE)
C
        INTEGER LUN,MODE
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
        INTEGER I,J,N,IW,IREL
C
C
C------ APPLY THE RELOCATIONS NOW THAT EVERY MODULE HAS BEEN SEEN.
C       TYPE 5 PATCHES THE LOW 16 BITS, THE VALUE FIELD (BITS 48-63),
C       WHICH IS CODE WORD 4.
C
C       THE VALUE FIELD IS NOT ALWAYS AN ABSOLUTE ADDRESS.  EVERY
C       RELOCATION IN THE SHIPPED LIBRARIES IS TYPE 5 -- ALL 867 OF
C       THEM -- SO THE RECORD DOES NOT SAY WHICH KIND IT IS.  THE
C       INSTRUCTION DOES.  A JMP/JSR CARRIES A MODE IN ITS SPD
C       SUBFIELD: 0 ABSOLUTE, 1 PC-RELATIVE, 2 TMA, 3 SWR.  VADD'S
C       "JSR SPUFLT" IS MODE 1, AND THE SHIPPED BAAHSR BLOCK PROVES
C       THE CONVENTION -- IT HOLDS VALUE=13 OCTAL (11.) AT PS(1) TO
C       REACH SPUFLT AT PS(12).  WRITING THE ABSOLUTE ADDRESS THERE
C       SENDS THE CALL THREE WORDS PAST ITS TARGET.
C
C       WORD 1 IS BITS 63-48.  DF IS BIT 15, SOP BITS 14-12, SPS BITS
C       9-6, SPD BITS 5-2.  DF=0 AND SOP=1 TOGETHER MAKE THE TOP FOUR
C       BITS EQUAL 1.  VADD'S JSR IS 011014 OCTAL = 4620 DECIMAL.
C
        IF (NFIX .LE. 0) GO TO 50
        DO 40 I=1,NFIX
          J = FIXSYM(I)
          IF (J .LT. 1) GO TO 40
          IF (SYMFLG(J) .EQ. 0) GO TO 40
          IW = CODE(1,FIXWRD(I))
          IREL = 0
          IF (IW .LT. 0) GO TO 35
          IF (IW/4096 .NE. 1) GO TO 35
          IF (MOD(IW/64,16) .NE. 8) GO TO 35
          IF (MOD(MOD(IW/4,16)/2,4) .NE. 1) GO TO 35
          IREL = 1
35        CONTINUE
          IF (IREL .EQ. 1) GO TO 38
          CODE(4,FIXWRD(I)) = SYMVAL(J)
          GO TO 40
38        CODE(4,FIXWRD(I)) = SYMVAL(J) - (FIXWRD(I)-1)
40      CONTINUE
50      CONTINUE
        IF (MODE .EQ. 1) GO TO 200
C
C------ E FORMAT (MANUAL SECTION 4.4, FIGURE 4-3)
C
C       THE FILE OPENS WITH THE NUMBER OF PROGRAM WORDS, THEN FOUR
C       VALUES PER LINE.  THE VALUES ARE **DECIMAL**, ZERO PADDED TO
C       FIVE DIGITS AND EACH FOLLOWED BY A PERIOD -- NOT OCTAL.  THE
C       FIGURE'S FIRST WORD IS 16384. WHICH IS 040000 OCTAL, AND ITS
C       LAST FIELD 00048. WHICH IS 60 OCTAL.  FIGURE 4-4 CONFIRMS THE
C       LEADING COUNT: THE A FORMAT EMITS "DATA CODE(1) / 8/".
C
        CALL PUTDEC (LUN,NCODE,1)
C
C       GUARD THE LOOP.  A FORTRAN IV DO IS BOTTOM-TESTED, SO
C       "DO 100 I=1,NCODE" RUNS ONCE EVEN WHEN NCODE IS ZERO, AND A
C       LIBRARY THAT DEFINES ONLY SYMBOLS -- SYMSRC IS ENTIRELY $EQU --
C       CAME OUT WITH ONE SPURIOUS LINE OF ZEROS AFTER THE COUNT.
C
        IF (NCODE .LE. 0) GO TO 110
        DO 100 I=1,NCODE
          CALL PUTDEC (LUN,CODE(1,I),4)
100     CONTINUE
110     RETURN
C
C------ A FORMAT
200     WRITE (LUN,910) FIRSTE(1),FIRSTE(2),FIRSTE(3)
910     FORMAT ('      SUBROUTINE ',3A2)
        N = NCODE * 4
        WRITE (LUN,920) N
920     FORMAT ('      INTEGER CODE(',I6,')')
        DO 210 I=1,NCODE
          WRITE (LUN,930) (CODE(J,I),J=1,4)
930       FORMAT ('      DATA /',4(1X,O6),'/')
210     CONTINUE
        WRITE (LUN,940)
940     FORMAT ('      RETURN'/'      END')
        RETURN
        END
C
C
C****** COMMAND-LEVEL ROUTINES ****************************************
C
        SUBROUTINE LOAD (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER FNAME(41),IST,N,I,INFILE
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
        IF (FROZEN .EQ. 0) GO TO 10
        WRITE (ITTO,1000)
1000    FORMAT (' LINKS FROZEN - RESET REQUIRED')
        RETURN
10      IF (NARG .GT. 0) GO TO 20
        WRITE (ITTO,1010)
1010    FORMAT (' ?')
        RETURN
C
C       OPEN THROUGH INFILE, NOT WITH A BARE ASSIGN.  LNK10.CMD LINKS
C       LIB100, AND INFILE IS ITS FILE INTERFACE -- IT TAKES A FILE
C       NUMBER AND ATTACHES THE FILE TO UNIT NUMBER+7, SO THE READ MUST
C       USE THE MAPPED UNIT.  A BARE ASSIGN WITH NO OPEN LEAVES THE UNIT
C       UNCONNECTED: THE FIRST READ THEN EITHER REPORTS NO SUCH FILE OR,
C       WORSE, FALLS BACK TO THE TERMINAL AND BLOCKS FOREVER.
C
20      DO 25 I=1,40
          FNAME(I+1) = 0
25      CONTINUE
        N = NARG
        IF (N .GT. 40) N = 40
        DO 30 I=1,N
          FNAME(I+1) = ARG(I)
30      CONTINUE
        FNAME(1) = N
        IST = INFILE (1,FNAME,IOBJ)
        IF (IST .NE. 0) GO TO 40
        CALL LODFIL (IOBJ+7)
        IST = INFILE (4,FNAME,IOBJ)
        WRITE (ITTO,1020)
1020    FORMAT (' LOAD COMPLETE')
        RETURN
40      WRITE (ITTO,1030)
1030    FORMAT (' FILE NOT FOUND OR UNAVAILABLE')
        RETURN
        END
C
C
        SUBROUTINE ENDMOD (ARG,NARG,MODE)
        LOGICAL*1 ARG(40)
        INTEGER NARG,MODE
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
C       E AND A BOTH FREEZE THE LINKS (SECTION 2.10).
        IF (NARG .LE. 0) GO TO 10
        CALL ASSIGN (IOUT,ARG,NARG)
        CALL EMTFIL (IOUT,MODE)
        CLOSE (UNIT=IOUT)
10      FROZEN = 1
        WRITE (ITTO,1000) FIRSTE(1),FIRSTE(2),FIRSTE(3),HIGH
1000    FORMAT (1X,3A2,3X,'HIGH=',O6)
        IF (NUNDEF .LE. 0) RETURN
        WRITE (ITTO,1010) NUNDEF
1010    FORMAT (1X,I3,' UNDEFINED SYMBOLS')
        RETURN
        END
C
C
        SUBROUTINE GETCMD (CMD,ARG,NARG)
        INTEGER NARG
        LOGICAL*1 CMD,ARG(40)
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
        INTEGER I
        LOGICAL*1 LINE(80),BL,GR,GM,GX
        DATA BL/' '/,GR/'R'/,GM/'M'/,GX/'X'/
C       THE PROMPT IS AN ASTERISK (SECTION 2.1).  THE COMMAND LETTER IS
C       ON ONE LINE; ANY ARGUMENT IS ON THE LINE THAT FOLLOWS.
        WRITE (ITTO,1000)
1000    FORMAT (' *')
        READ (ITTI,1010,END=90) LINE
1010    FORMAT (80A1)
        CMD = LINE(1)
        NARG = 0
        DO 20 I=1,40
          ARG(I) = BL
20      CONTINUE
        IF (CMD .EQ. GR) RETURN
        IF (CMD .EQ. GM) RETURN
        IF (CMD .EQ. GX) RETURN
        READ (ITTI,1010,END=90) LINE
        DO 30 I=1,40
          ARG(I) = LINE(I)
30      CONTINUE
        DO 40 I=1,40
          IF (ARG(41-I) .NE. BL) GO TO 50
40      CONTINUE
        RETURN
50      NARG = 41 - I
        RETURN
90      CMD = GX
        NARG = 0
        RETURN
        END
C
C
        SUBROUTINE ARGNAM (ARG,NARG,NAME)
        LOGICAL*1 ARG(40),PAD(8)
        INTEGER NARG,NAME(3),I
        LOGICAL*1 BL
        DATA BL/' '/
        DO 10 I=1,8
          PAD(I) = BL
          IF (I .LE. NARG) PAD(I) = ARG(I)
10      CONTINUE
        CALL PACK6 (PAD,1,NAME)
        RETURN
        END
C
C
        SUBROUTINE NUMIN (ARG,NARG,IVAL)
        LOGICAL*1 ARG(40)
        INTEGER NARG,IVAL
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
        LOGICAL*1 ZERO,NINE,BLA,BLF
        INTEGER I,D
        DATA ZERO/'0'/,NINE/'9'/,BLA/'A'/,BLF/'F'/
        IVAL = 0
        DO 20 I=1,NARG
          D = -1
          IF (ARG(I) .LT. ZERO) GO TO 10
          IF (ARG(I) .GT. NINE) GO TO 10
          D = ARG(I) - ZERO
10        IF (IRADIX .NE. 16) GO TO 15
          IF (ARG(I) .LT. BLA) GO TO 15
          IF (ARG(I) .GT. BLF) GO TO 15
          D = ARG(I) - BLA + 10
15        IF (D .LT. 0) GO TO 20
          IF (D .GE. IRADIX) GO TO 20
          IVAL = IVAL * IRADIX + D
20      CONTINUE
        RETURN
        END
C
C
        SUBROUTINE OPNOUT (ARG,NARG,LUN)
        LOGICAL*1 ARG(40)
        INTEGER NARG,LUN
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
        LOGICAL*1 T,Y
        DATA T/'T'/,Y/'Y'/
C       A LISTING DESTINATION OF TTY MEANS THE TERMINAL (SECTION 2.4).
        LUN = ITTO
        IF (NARG .LE. 0) RETURN
C       (kept short: the single-line form ran to column 73 and the
C       trailing RETURN was truncated)
        IF (ARG(1) .NE. T) GO TO 10
        IF (ARG(2) .NE. T) GO TO 10
        IF (ARG(3) .EQ. Y) RETURN
10      CONTINUE
        CALL ASSIGN (IOUT,ARG,NARG)
        LUN = IOUT
        RETURN
        END
C
C
        SUBROUTINE CLSOUT (LUN)
        INTEGER LUN
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
        IF (LUN .EQ. ITTO) RETURN
        CLOSE (UNIT=LUN)
        RETURN
        END
C
C
C****** BATCH = DRIVE THE LINKER FROM THE MCR COMMAND LINE ************
C
C       EXTENSION, NOT RECOVERED BEHAVIOUR -- SEE THE NOTE IN THE MAIN
C       PROGRAM.  FOLLOWS THE APEEL.FTN IDIOM.
C
        SUBROUTINE BATCH (TTBUF,IDS)
        LOGICAL*1 TTBUF(80)
        INTEGER IDS
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LNKCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LNKCOM
        INTEGER CODE,NCODE                                              LNKCOM
        COMMON /LNKCOM/ SYMNAM(3,600),SYMVAL(600),SYMFLG(600),          LNKCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LNKCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LNKCOM
        COMMON /CODCOM/ CODE(4,2400),NCODE                              LNKCOM
        COMMON /FIXCOM/ FIXWRD(1000),FIXSYM(1000),NFIX                  LNKCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LNKCOM
        LOGICAL*1 LEQ
        INTEGER I,IEQ,LOUT,LIN
        DATA LEQ/'='/
        IEQ = 0
        DO 10 I=5,IDS
          IF (TTBUF(I) .NE. LEQ) GO TO 10
          IEQ = I
          GO TO 20
10      CONTINUE
20      IF (IEQ .NE. 0) GO TO 30
        WRITE (ITTO,1000)
1000    FORMAT (' LNK -- COMMAND LINE MUST BE (OUT)=(IN)')
        RETURN
30      LOUT = IEQ - 5
        LIN = IDS - IEQ
        IF (LOUT .GT. 0 .AND. LIN .GT. 0) GO TO 40
        WRITE (ITTO,1000)
        RETURN
40      CALL ASSIGN (IOBJ,TTBUF(IEQ+1),LIN)
        CALL LODFIL (IOBJ)
        CLOSE (UNIT=IOBJ)
        CALL ASSIGN (IOUT,TTBUF(5),LOUT)
        CALL EMTFIL (IOUT,0)
        CLOSE (UNIT=IOUT)
        WRITE (ITTO,1010) HIGH
1010    FORMAT (' HIGH=',O6)
        IF (NUNDEF .LE. 0) RETURN
        WRITE (ITTO,1020) NUNDEF
1020    FORMAT (1X,I3,' UNDEFINED SYMBOLS')
        RETURN
        END
C
C
C****** PUTDEC = WRITE N VALUES AS ZERO-PADDED DECIMAL WITH PERIODS **
C
C       FORTRAN IV HAS NO I5.5 EDIT DESCRIPTOR, SO THE DIGITS ARE BUILT
C       BY HAND.  FIGURE 4-3 SHOWS FIELDS LIKE "16384." AND "00048.",
C       FIVE DIGITS ZERO PADDED, EACH FOLLOWED BY A PERIOD, TWO SPACES
C       BETWEEN FIELDS.
C
        SUBROUTINE PUTDEC (LUN,V,N)
        INTEGER LUN,V(4),N
        LOGICAL*1 OUT(40),BL,DOT
        INTEGER I,J,P
        DATA BL/' '/,DOT/'.'/
        P = 0
        DO 40 I=1,N
          CALL DIG5 (OUT,P,V(I))
          P = P + 5
          P = P + 1
          OUT(P) = DOT
          IF (I .GE. N) GO TO 40
          P = P + 1
          OUT(P) = BL
          P = P + 1
          OUT(P) = BL
40      CONTINUE
        WRITE (LUN,900) (OUT(J),J=1,P)
900     FORMAT (1X,40A1)
        RETURN
        END
C
C
C****** DIG5 = FIVE DECIMAL DIGITS OF AN UNSIGNED 16-BIT WORD ********
C
        SUBROUTINE DIG5 (OUT,P,V)
        LOGICAL*1 OUT(40),ZERO
        INTEGER P,V,I,K,D,HI,LO
        DATA ZERO/'0'/
C
C       THE WORD IS UNSIGNED: FIGURE 4-3 CARRIES 43008. AND 32768.,
C       BOTH OF WHICH HAVE BIT 15 SET.  A NEGATIVE INTEGER*2 CANNOT
C       SIMPLY HAVE 65536 ADDED TO IT, SO SPLIT THE VALUE AND ADD
C       32768 AS 3*10000 + 2768 WITH A CARRY.
C
        IF (V .LT. 0) GO TO 20
        HI = V / 10000
        LO = V - HI*10000
        GO TO 30
20      LO = V + 32767
        LO = LO + 1
        HI = LO / 10000
        LO = LO - HI*10000
        HI = HI + 3
        LO = LO + 2768
        IF (LO .LT. 10000) GO TO 30
        LO = LO - 10000
        HI = HI + 1
30      OUT(P+1) = ZERO + HI
        K = 1000
        DO 40 I=1,4
          D = LO / K
          OUT(P+I+1) = ZERO + D
          LO = LO - D*K
          K = K / 10
40      CONTINUE
        RETURN
        END
