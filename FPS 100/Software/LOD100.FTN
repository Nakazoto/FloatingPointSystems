C+++    MAIN
C****** LOD100 = FPS-100 LOADER = RECONSTRUCTION 0.01 ****************
C
C       THIS IS NOT FPS SOURCE.  LOD100.FTN WAS SHIPPED -- SHORT.DAT,
C       THE DISTRIBUTION'S OWN SHORT INDEX, LISTS IT AS FILE 62,
C       "FPS100>DE04>PDS>LOD100.ALL", PASS 2 -- BUT IS ABSENT FROM THE
C       1986 DISK DUMP AND NO BINARY SURVIVES.  THIS IS A
C       REIMPLEMENTATION FROM THE PUBLISHED SPEC:
C
C         FPS-100 LOADER (LOD100) REFERENCE MANUAL, 860-7423-000, 1979
C           CHAPTER 2  COMMANDS, OVERLAY TABLE, TCB, READY QUEUE
C           CHAPTER 3  OBJECT MODULE FORMAT
C           CHAPTER 4  LOAD MODULE AND HASI
C
C       CROSS-CHECKED AGAINST LOD100.PY IN THIS REPOSITORY, AND AGAINST
C       FSLMLD IN FDAPEX.FTN, WHICH IS THE ROUTINE THAT ACTUALLY READS
C       THE LOAD MODULES THIS PRODUCES.
C
C       THE OBJECT MODULE READER (LODFIL, STARS, GETNUM, PACK6, SYMLU)
C       IS CARRIED OVER VERBATIM FROM LNK100.FTN, WHOSE OUTPUT HAS BEEN
C       DIFFED WORD FOR WORD AGAINST LNK100.PY AND FOUND IDENTICAL.
C       BOTH TOOLS READ THE SAME APO FORMAT, SO THE READER IS SHARED --
C       WHICH IS ALSO WHY IT WAS VALIDATED FIRST.
C
C       MODULE NAMES FOLLOW LOD100'S OWN OVERLAY DESCRIPTOR, RECOVERED
C       FROM INSTAL.TXT SECTION 9.14, WHICH NAMES 54 MODULES.  THE ONES
C       PRESENT HERE ARE THE ROOT AND COMMAND-HANDLING SET:
C         .MAIN. COMAND INPUT OUTPUT LOAD LIB INIT FINISH ERRMES
C         PSOFF MDOFF MMAX WRTLM WRTLIN LOADMP
C       THE OVERLAY, TASK AND ISR BRANCHES ARE NOT YET WRITTEN.
C
C       COMMANDS IMPLEMENTED (MANUAL SECTION 2.3):
C         OUTPUT </size> hasifile lmfile-a </D> <lmfile-b/D>
C         LMID idnum        RADIX rad        MODE TASK
C         LOAD file         LIB file         INPUT file
C         PSOFF n           MDOFF n          MMAX n
C         MAP file          INIT             EXIT
C
C       NOTE ON OUTPUT: THE **FIRST** FILE IS THE HASI FILE AND THE
C       SECOND IS THE LOAD MODULE (SECTION 2.3.2, "OUTPUT HASI LMOD1").
C       LOD100.PY CURRENTLY TREATS THE FIRST AS THE LOAD MODULE, WHICH
C       IS A BUG IN THAT TOOL, FOUND WHILE WRITING THIS.
C
        PROGRAM LOD100
C
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER LMID,PSOFF,MDOFF,MODTSK,HASLUN                          LODCOM
        COMMON /LODCOM/ LMID,PSOFF,MDOFF,MODTSK,HASLUN                  LODCOM
C
        INTEGER NARG
        LOGICAL*1 CMD,ARG(40)
        LOGICAL*1 C1,C2,C3
C
        ITTI = 5
        ITTO = 6
        IOBJ = 1
        IOUT = 2
        HASLUN = 3
        IRADIX = 8
        CALL INIT
C
        WRITE (ITTO,1000)
1000    FORMAT (' LOD100  REL. 0.01 , RECONSTRUCTION')
C
100     CONTINUE
        CALL COMAND (C1,C2,C3,ARG,NARG)
        IF (C1 .EQ. 0) GO TO 100
        CALL DISPAT (C1,C2,C3,ARG,NARG)
        IF (FROZEN .NE. 2) GO TO 100
        WRITE (ITTO,1010)
1010    FORMAT (' END LOD100')
        CALL EXIT
        END
C
C
C****** DISPAT = COMMAND DISPATCH ************************************
C
        SUBROUTINE DISPAT (C1,C2,C3,ARG,NARG)
        LOGICAL*1 C1,C2,C3,ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        LOGICAL*1 LO,LL,LM,LR,LP,LE,LI,LD,LA,LB,LS,LX,LT,LN
        DATA LO/'O'/,LL/'L'/,LM/'M'/,LR/'R'/,LP/'P'/,LE/'E'/
        DATA LI/'I'/,LD/'D'/,LA/'A'/,LB/'B'/,LS/'S'/,LX/'X'/
        DATA LT/'T'/,LN/'N'/
        LOGICAL*1 LC,LV
        DATA LC/'C'/,LV/'V'/
C
C       COMMANDS ARE RECOGNISED ON ENOUGH LEADING CHARACTERS TO BE
C       UNAMBIGUOUS, WHICH IS WHAT THE MANUAL'S ABBREVIATIONS IMPLY
C       (OUTPUT/O, RADIX/R, LMID/LM, MODE/MO, INPUT/INP).
C
        IF (C1 .NE. LO) GO TO 12
        IF (C2 .EQ. LV) GO TO 294
        GO TO 200
12      CONTINUE
        IF (C1 .EQ. LR) GO TO 210
        IF (C1 .EQ. LE) GO TO 290
        IF (C1 .NE. LL) GO TO 20
        IF (C2 .EQ. LM) GO TO 220
        IF (C2 .EQ. LI) GO TO 240
        GO TO 230
20      IF (C1 .NE. LM) GO TO 30
        IF (C2 .EQ. LO) GO TO 250
        IF (C2 .EQ. LD) GO TO 270
        IF (C2 .EQ. LM) GO TO 280
        GO TO 260
30      IF (C1 .NE. LP) GO TO 32
        IF (C2 .EQ. LR) GO TO 292
        GO TO 275
32      IF (C1 .NE. LT) GO TO 34
        IF (C2 .EQ. LA) GO TO 293
        GO TO 296
34      IF (C1 .EQ. LC) GO TO 295
        IF (C1 .EQ. LI) GO TO 285
        WRITE (ITTO,1000)
1000    FORMAT (' ?')
        RETURN
C
200     CALL OUTPUT (ARG,NARG)
        RETURN
210     CALL SETRAD (ARG,NARG)
        RETURN
220     CALL SETLM (ARG,NARG)
        RETURN
230     CALL LOAD (ARG,NARG)
        RETURN
240     CALL LOAD (ARG,NARG)
        RETURN
250     CALL SETMOD (ARG,NARG)
        RETURN
260     CALL LOADMP (ARG,NARG)
        RETURN
270     CALL SETMD (ARG,NARG)
        RETURN
275     CALL SETPS (ARG,NARG)
        RETURN
280     CALL SETMMX (ARG,NARG)
        RETURN
285     CALL INIT
        RETURN
292     CALL APPRIO (ARG,NARG)
        RETURN
293     CALL TASKY (ARG,NARG)
        RETURN
294     CALL OVLY (ARG,NARG)
        RETURN
295     CALL CALLS (ARG,NARG)
        RETURN
296     CALL TREE (ARG,NARG)
        RETURN
290     CALL FINISH
        RETURN
        END
C
C
C****** INIT = REINITIALIZE THE LOADER = SECTION 2.3.24 **************
C
        SUBROUTINE INIT
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LODCOM
        COMMON /FIXCOM/ FIXWRD(600),FIXSYM(600),NFIX                    LODCOM
        INTEGER LMID,PSOFF,MDOFF,MODTSK,HASLUN                          LODCOM
        COMMON /LODCOM/ LMID,PSOFF,MDOFF,MODTSK,HASLUN                  LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER I,J
        NSYM = 0
        HIGH = 0
        BASE = 0
        NEXTLC = 0
        NUNDEF = 0
        FROZEN = 0
        LODCNT = 0
        NCODE = 0
        NFIX = 0
        LMID = 1
        PSOFF = 0
        MDOFF = 0
        MODTSK = 0
        DO 10 I=1,3
          FIRSTE(I) = 0
10      CONTINUE
        DO 20 J=1,1200
          DO 15 I=1,4
            CODE(I,J) = 0
15        CONTINUE
20      CONTINUE
        NOVL = 0
        CUROV = 0
        NTSK = 0
        OVMARK = 0
        OVTADR = 0
        PRTADR = 0
        TCBADR = 0
        DO 90 I=1,24
          OVNUM(I) = 0
          OVPAR(I) = 0
          OVPS(I) = 0
          OVLN(I) = 0
          OVMD(I) = 0
          OVTSK(I) = 0
          OVPRT(I) = 0
          OVNPR(I) = 0
          OVBEG(I) = 0
90      CONTINUE
        DO 95 I=1,8
          TSKID(I) = 0
          TSKPRI(I) = 0
          TSKOPT(I) = 0
          TSKFRT(I) = 0
95      CONTINUE
        DO 97 I=1,400
          SYMSEG(I) = 0
97      CONTINUE
        RETURN
        END
C
C
C****** OUTPUT = DECLARE THE HASI AND LOAD MODULE FILES = 2.3.2 ******
C
        SUBROUTINE OUTPUT (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
C
C       OUTPUT </SIZE> HASIFILE LMFILE-A </D> <LMFILE-B/D>
C       THE FIRST FILE NAMED IS THE HASI FILE, THE SECOND THE LOAD
C       MODULE.  /D SELECTS THE DISK-RESIDENT BINARY FORM, WHICH IS THE
C       ONLY FORM SIM100 AND DBG100 CAN USE; WITHOUT IT A HOST-RESIDENT
C       FORTRAN LOAD MODULE IS PRODUCED, AND THAT IS THE DEFAULT.
C
C       ONLY THE SECOND NAME IS ACTED ON HERE; HASI GENERATION IS NOT
C       YET WRITTEN, SO THE FIRST IS ACCEPTED AND RECORDED ONLY.
C
        INTEGER I,N1,N2,S1,S2
        CALL FLD2 (ARG,NARG,S1,N1,S2,N2)
        IF (N2 .GT. 0) GO TO 10
        WRITE (ITTO,1000)
1000    FORMAT (' OUTPUT REQUIRES A HASI FILE AND A LOAD MODULE FILE')
        RETURN
10      CALL ASSIGN (IOUT,ARG(S2),N2)
        FROZEN = 0
        RETURN
        END
C
C
C****** FINISH = GENERATE THE LOAD MODULE AND EXIT = 2.3.25 **********
C
        SUBROUTINE FINISH
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LODCOM
        COMMON /FIXCOM/ FIXWRD(600),FIXSYM(600),NFIX                    LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER I,J,IW,IREL,IPSA,IS
C
C       APPLY RELOCATIONS, EXACTLY AS LNK100 DOES AT E/A TIME.
C
C       THE VALUE FIELD IS NOT ALWAYS AN ABSOLUTE ADDRESS.  A JMP/JSR
C       CARRIES A MODE IN ITS SPD SUBFIELD -- 0 ABSOLUTE, 1 PC-RELATIVE,
C       2 TMA, 3 SWR -- AND MODE 1 TAKES A DISPLACEMENT.  SEE LNK100.
C
        CALL LINKUP
        IF (NFIX .LE. 0) GO TO 50
        DO 40 I=1,NFIX
          J = FIXSYM(I)
          IF (J .LT. 1) GO TO 40
          IF (SYMFLG(J) .EQ. 0) GO TO 40
          IW = CODE(1,FIXWRD(I))
          IREL = 0
          IF (IW .LT. 0) GO TO 35
          IF (IW/4096 .NE. 1) GO TO 35
          IF (MOD(IW/64,16) .NE. 8) GO TO 35
          IF (MOD(MOD(IW/4,16)/2,4) .NE. 1) GO TO 35
          IREL = 1
35        CONTINUE
          IF (IREL .EQ. 1) GO TO 36
          CODE(4,FIXWRD(I)) = SYMVAL(J)
          GO TO 40
C
C         THE INSTRUCTION'S OWN PS ADDRESS.  MODULES LOAD SEQUENTIALLY
C         FROM PSOFF, SO A FLAT JOB IS PSOFF+FIXWRD-1.  WITH OVERLAYS A
C         SEGMENT BEGINS AT CODE INDEX OVBEG AND MOVES TO OVPS, THE SAME
C         SHIFT LINKUP APPLIES TO THE SYMBOLS.
36        IPSA = PSOFF + FIXWRD(I) - 1
          IF (NOVL .LE. 0) GO TO 38
          DO 37 IS=1,NOVL
            IF (FIXWRD(I) .LT. OVBEG(IS)) GO TO 37
            IF (FIXWRD(I) .GE. OVBEG(IS)+OVLN(IS)) GO TO 37
            IPSA = OVPS(IS) + FIXWRD(I) - OVBEG(IS)
37        CONTINUE
38        CODE(4,FIXWRD(I)) = SYMVAL(J) - IPSA
40      CONTINUE
50      CONTINUE
        CALL WRTLM (IOUT)
        CLOSE (UNIT=IOUT)
        WRITE (ITTO,1000) NCODE,HIGH
1000    FORMAT (1X,I5,' INSTRUCTIONS, HIGH=',O6)
        IF (NUNDEF .GT. 0) WRITE (ITTO,1010) NUNDEF
1010    FORMAT (1X,I3,' UNDEFINED SYMBOLS')
        FROZEN = 2
        RETURN
        END
C
C
C****** WRTLM = WRITE THE HOST RESIDENT LOAD MODULE = SECTION 4.2 ****
C
        SUBROUTINE WRTLM (LUN)
        INTEGER LUN
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        INTEGER LMID,PSOFF,MDOFF,MODTSK,HASLUN                          LODCOM
        COMMON /LODCOM/ LMID,PSOFF,MDOFF,MODTSK,HASLUN                  LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER EBUF,NEBUF,NEMIT,ELUN                                   LODCOM
        COMMON /EMTCOM/ EBUF(4),NEBUF,NEMIT,ELUN                        LODCOM
        INTEGER I,J,K
C
C       BUILD THE BLOCK SEQUENCE FSLMLD READS (FDAPEX.FTN).  FSLMLD
C       DISPATCHES ON TTYPE = WORD0 + 1, SO:
C           TYPE 0  CODE.  HEADER [0,CNT,ADDR,PG,DEST,0,0,0] THEN CNT
C                   HOST WORDS.  FOR DEST=0 IT CALLS
C                   LOADPS(BUF,ADDR,CNT*PAKFAC/4), SO ON A 16-BIT HOST
C                   ONE 64-BIT PS INSTRUCTION IS FOUR WORDS AND CNT IS
C                   A **WORD** COUNT, NOT AN INSTRUCTION COUNT.
C           TYPE 2  INFO.   [2,PPAAD,PPAEND,LMID,OVLEN,OVADDR,0,0]
C           TYPE 3  END.    [3,0,...] LOGICAL, THEN [3,1,...] TERMINATING
C
C       THE MODULE IS STREAMED A BLOCK AT A TIME RATHER THAN BUFFERED.
C       A WHOLE-MODULE BUFFER PUSHES $DATAP OVER 32K WORDS AND THE TASK
C       BUILD FAILS WITH "SECTION $DATAP HAS OVERFLOWED" -- WHICH IS
C       PRESUMABLY WHY THE ORIGINAL HAS A WRTBR AT ALL.
C
        ELUN = LUN
        NEBUF = 0
        NEMIT = 0
        WRITE (LUN,900) LMID*100+1
900     FORMAT ('      SUBROUTINE L',I5)
        WRITE (LUN,910) 20000
910     FORMAT ('      INTEGER CODE(',I6,')')
        IF (NOVL .GT. 0) GO TO 40
C       FLAT JOB: ONE CODE BLOCK AT THE PROGRAM SOURCE ORIGIN.
        K = NCODE * 4
        IF (K .LE. 0) GO TO 60
        CALL PUTHDR (K,PSOFF,0)
        CALL EMITCD (1,NCODE)
        GO TO 60
C
C       OVERLAID: EACH SEGMENT IMAGE GOES TO MAIN DATA AT ITS OWN
C       ADDRESS, BECAUSE THE SUPERVISOR COPIES IT INTO PROGRAM SOURCE
C       WHEN THE SEGMENT IS ENTERED (SECTION 2.8, APOVLD).
C
40      DO 50 K=1,NOVL
          IF (OVLN(K) .LE. 0) GO TO 50
          CALL PUTHDR (OVLN(K)*4,OVMD(K),1)
          I = OVBEG(K)
          J = I + OVLN(K) - 1
          CALL EMITCD (I,J)
50      CONTINUE
        CALL WRTBR
60      CONTINUE
C       INFO BLOCK
        CALL EMITW (2)
        CALL EMITW (0)
        CALL EMITW (0)
        CALL EMITW (LMID)
        CALL EMITW (NOVL*8)
        CALL EMITW (OVTADR)
        CALL EMITW (0)
        CALL EMITW (0)
C       LOGICAL END THEN TERMINATING END
        CALL EMITW (3)
        DO 70 I=1,7
          CALL EMITW (0)
70      CONTINUE
        CALL EMITW (3)
        CALL EMITW (1)
        DO 80 I=1,6
          CALL EMITW (0)
80      CONTINUE
        CALL EFLUSH
        WRITE (LUN,940) LMID
940     FORMAT ('      CALL FSLMLD(',I6,',CODE)')
        WRITE (LUN,950)
950     FORMAT ('      RETURN'/'      END')
        RETURN
        END
C
C
        SUBROUTINE EMITCD (IB,IE)
        INTEGER IB,IE
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        INTEGER I,J
        DO 20 I=IB,IE
          DO 10 J=1,4
            CALL EMITW (CODE(J,I))
10        CONTINUE
20      CONTINUE
        RETURN
        END
C
C
        SUBROUTINE EMITW (V)
        INTEGER V
        INTEGER EBUF,NEBUF,NEMIT,ELUN                                   LODCOM
        COMMON /EMTCOM/ EBUF(4),NEBUF,NEMIT,ELUN                        LODCOM
        NEBUF = NEBUF + 1
        EBUF(NEBUF) = V
        IF (NEBUF .LT. 4) RETURN
        CALL EDUMP
        RETURN
        END
C
C
        SUBROUTINE EFLUSH
        INTEGER EBUF,NEBUF,NEMIT,ELUN                                   LODCOM
        COMMON /EMTCOM/ EBUF(4),NEBUF,NEMIT,ELUN                        LODCOM
C       PAD THE LAST GROUP TO FOUR SO THE FIXED FORMAT IS SAFE.
        IF (NEBUF .EQ. 0) RETURN
10      IF (NEBUF .GE. 4) GO TO 20
        NEBUF = NEBUF + 1
        EBUF(NEBUF) = 0
        GO TO 10
20      CALL EDUMP
        RETURN
        END
C
C
        SUBROUTINE EDUMP
        INTEGER EBUF,NEBUF,NEMIT,ELUN                                   LODCOM
        COMMON /EMTCOM/ EBUF(4),NEBUF,NEMIT,ELUN                        LODCOM
        INTEGER I,J,K
C       THE COLON EDIT DESCRIPTOR STOPS FORMAT PROCESSING WHEN THE ITEM
C       LIST RUNS OUT, WHICH ALSO SWALLOWS A TRAILING LITERAL -- SO
C       4(I7,:,','),'/' NEVER EMITS THE SLASH.  FIGURE 4-1 SHOWS
C       "DATA CODE(   1),...,CODE(   4)/" THEN THE VALUES ENDING "/",
C       SO WRITE FIXED GROUPS OF FOUR INSTEAD.
        I = NEMIT + 1
        K = NEMIT + 4
        WRITE (ELUN,920) (J,J=I,K)
920     FORMAT ('      DATA ',3('CODE(',I6,'),'),'CODE(',I6,')/')
        WRITE (ELUN,930) (EBUF(J),J=1,4)
930     FORMAT ('     *',3(I7,','),I7,'/')
        NEMIT = NEMIT + 4
        NEBUF = 0
        RETURN
        END
C
C
C       (SGN16 REMOVED.  IT WAS AN IDENTITY FUNCTION, AND BECAUSE ITS
C       NAME BEGINS WITH S IT DEFAULTED TO REAL IN THE CALLER, WHICH
C       MADE THE I7 EDIT DESCRIPTOR FAIL AT RUN TIME WITH
C       "FORMAT/VARIABLE-TYPE MISMATCH".  THE WORDS ARE ALREADY SIGNED
C       INTEGER*2 BECAUSE GETNUM FOLDS THE TOP BIT IN AS IT PARSES.)
C
C
C****** SMALL COMMAND HANDLERS ***************************************
C
        SUBROUTINE SETLM (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER LMID,PSOFF,MDOFF,MODTSK,HASLUN                          LODCOM
        COMMON /LODCOM/ LMID,PSOFF,MDOFF,MODTSK,HASLUN                  LODCOM
        CALL NUMIN (ARG,NARG,LMID)
        RETURN
        END
C
        SUBROUTINE SETPS (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER LMID,PSOFF,MDOFF,MODTSK,HASLUN                          LODCOM
        COMMON /LODCOM/ LMID,PSOFF,MDOFF,MODTSK,HASLUN                  LODCOM
        CALL NUMIN (ARG,NARG,PSOFF)
        RETURN
        END
C
        SUBROUTINE SETMD (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER LMID,PSOFF,MDOFF,MODTSK,HASLUN                          LODCOM
        COMMON /LODCOM/ LMID,PSOFF,MDOFF,MODTSK,HASLUN                  LODCOM
        CALL NUMIN (ARG,NARG,MDOFF)
        RETURN
        END
C
        SUBROUTINE SETMMX (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER IV
        CALL NUMIN (ARG,NARG,IV)
        RETURN
        END
C
        SUBROUTINE SETMOD (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER LMID,PSOFF,MDOFF,MODTSK,HASLUN                          LODCOM
        COMMON /LODCOM/ LMID,PSOFF,MDOFF,MODTSK,HASLUN                  LODCOM
C       MODE TASK -- SUPERVISOR TASKS WILL BE LOADED (SECTION 2.3.5).
        MODTSK = 1
        RETURN
        END
C
        SUBROUTINE SETRAD (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER IV
        CALL NUMIN (ARG,NARG,IV)
        IF (IV .EQ. 8)  IRADIX = 8
        IF (IV .EQ. 10) IRADIX = 10
        IF (IV .EQ. 16) IRADIX = 16
        RETURN
        END
C
        SUBROUTINE LOAD (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER FNAME(41),IST,N,I,INFILE
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        IF (NARG .GT. 0) GO TO 10
        WRITE (ITTO,1000)
1000    FORMAT (' ?')
        RETURN
C
C       OPEN THROUGH INFILE, NOT A BARE ASSIGN.  LOD10.CMD LINKS LIB100
C       AND INFILE IS ITS FILE INTERFACE: IT TAKES A FILE NUMBER AND
C       ATTACHES THE FILE TO UNIT NUMBER+7, SO THE READ USES THE MAPPED
C       UNIT.  AN ASSIGN WITH NO OPEN LEAVES THE UNIT UNCONNECTED AND
C       THE FIRST READ EITHER REPORTS NO SUCH FILE OR FALLS BACK TO THE
C       TERMINAL AND BLOCKS.  LOD100.CMD ASKS FOR UNITS=17, WHICH IS
C       THE HIGHEST FILE NUMBER THIS TOOL USES, 10, PLUS 7.
C
10      DO 12 I=1,40
          FNAME(I+1) = 0
12      CONTINUE
        N = NARG
        IF (N .GT. 40) N = 40
        DO 14 I=1,N
          FNAME(I+1) = ARG(I)
14      CONTINUE
        FNAME(1) = N
        IST = INFILE (1,FNAME,IOBJ)
        IF (IST .NE. 0) GO TO 16
        CALL LODFIL (IOBJ+7)
        IST = INFILE (4,FNAME,IOBJ)
        RETURN
16      WRITE (ITTO,1010)
1010    FORMAT (' FILE NOT FOUND OR UNAVAILABLE')
        RETURN
        END
C
        SUBROUTINE LOADMP (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        INTEGER I
C       MAP: THE LOAD MAP (SECTION 2.3.22).
        WRITE (ITTO,1000) NCODE,HIGH
1000    FORMAT (' LOAD MAP:',I6,' INSTRUCTIONS, HIGH=',O6)
        IF (NSYM .LE. 0) RETURN
        DO 20 I=1,NSYM
          WRITE (ITTO,1010) SYMNAM(1,I),SYMNAM(2,I),SYMNAM(3,I),
     1                      SYMVAL(I)
1010      FORMAT (3X,3A2,3X,O6)
20      CONTINUE
        RETURN
        END
C
C
C****** COMAND = READ AND SPLIT A COMMAND LINE ***********************
C
        SUBROUTINE COMAND (C1,C2,C3,ARG,NARG)
        LOGICAL*1 C1,C2,C3,ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER IIN,ITTI0                                               LODCOM
        COMMON /INCOM/ IIN,ITTI0                                        LODCOM
        LOGICAL*1 LINE(80),BL,AT
        INTEGER I,J,K,N
        INTEGER IINF
        DATA IINF/4/
        DATA BL/' '/,AT/'@'/
C
C       LOD100 TAKES A KEYWORD AND ITS ARGUMENTS ON ONE LINE, UNLIKE
C       LNK100'S TWO-LINE DIALOGUE.  THE PROMPT IS STILL AN ASTERISK.
C
C       A LINE BEGINNING '@' SWITCHES INPUT TO THE NAMED FILE UNTIL ITS
C       END, THEN REVERTS TO THE TERMINAL.  INSTAL.TXT DRIVES EVERY PDS
C       TOOL FROM INDIRECT FILES, AND AN INTERACTIVE-ONLY LOADER CANNOT
C       SIT IN A BUILD PROCEDURE.  ONE LEVEL, NOT NESTED.
C
        IF (IIN .EQ. 0) IIN = ITTI
1       IF (IIN .NE. ITTI) GO TO 2
        WRITE (ITTO,1000)
1000    FORMAT (' *')
2       CONTINUE
        C1 = BL
        C2 = BL
        C3 = BL
        NARG = 0
        DO 5 I=1,40
          ARG(I) = BL
5       CONTINUE
        READ (IIN,1010,END=90) LINE
1010    FORMAT (80A1)
        I = 1
        IF (LINE(1) .NE. AT) GO TO 6
C       INDIRECT: OPEN THE FILE AND READ THE NEXT COMMAND FROM IT.
        IF (IIN .NE. ITTI) GO TO 1
        N = 0
        DO 3 K=2,80
          IF (LINE(K) .EQ. BL) GO TO 4
          N = K - 1
3       CONTINUE
4       IF (N .LE. 0) GO TO 1
        CALL ASSIGN (IINF,LINE(2),N)
        IIN = IINF
        GO TO 1
6       CONTINUE
7       IF (I .GT. 78) RETURN
        IF (LINE(I) .NE. BL) GO TO 8
        I = I + 1
        GO TO 7
8       C1 = LINE(I)
        C2 = LINE(I+1)
        C3 = LINE(I+2)
C       SKIP THE KEYWORD, THEN THE BLANKS AFTER IT
10      IF (I .GT. 80) RETURN
        IF (LINE(I) .EQ. BL) GO TO 20
        I = I + 1
        GO TO 10
20      IF (I .GT. 80) RETURN
        IF (LINE(I) .NE. BL) GO TO 30
        I = I + 1
        GO TO 20
30      J = 0
        DO 40 K=I,80
          IF (J .GE. 40) GO TO 50
          J = J + 1
          ARG(J) = LINE(K)
40      CONTINUE
50      NARG = 0
        DO 60 K=1,40
          IF (ARG(41-K) .NE. BL) GO TO 70
60      CONTINUE
        RETURN
70      NARG = 41 - K
        RETURN
90      IF (IIN .EQ. ITTI) GO TO 95
C       END OF AN INDIRECT FILE: FALL BACK TO THE TERMINAL.
        CLOSE (UNIT=IIN)
        IIN = ITTI
        GO TO 1
95      C1 = 1HE
        NARG = 0
        RETURN
        END
C
C
C****** FLD2 = LOCATE THE FIRST TWO BLANK-SEPARATED FIELDS ***********
C
        SUBROUTINE FLD2 (ARG,NARG,S1,N1,S2,N2)
        LOGICAL*1 ARG(40),BL
        INTEGER NARG,S1,N1,S2,N2,I
        DATA BL/' '/
        S1 = 0
        N1 = 0
        S2 = 0
        N2 = 0
        I = 1
10      IF (I .GT. NARG) RETURN
        IF (ARG(I) .NE. BL) GO TO 20
        I = I + 1
        GO TO 10
20      S1 = I
30      IF (I .GT. NARG) GO TO 40
        IF (ARG(I) .EQ. BL) GO TO 40
        I = I + 1
        GO TO 30
40      N1 = I - S1
50      IF (I .GT. NARG) RETURN
        IF (ARG(I) .NE. BL) GO TO 60
        I = I + 1
        GO TO 50
60      S2 = I
70      IF (I .GT. NARG) GO TO 80
        IF (ARG(I) .EQ. BL) GO TO 80
        I = I + 1
        GO TO 70
80      N2 = I - S2
        RETURN
        END
C
C
        SUBROUTINE NUMIN (ARG,NARG,IVAL)
        LOGICAL*1 ARG(40)
        INTEGER NARG,IVAL
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        LOGICAL*1 ZERO,NINE
        INTEGER I,D
        DATA ZERO/'0'/,NINE/'9'/
C       STOP AT THE FIRST NON-DIGIT ONCE DIGITS HAVE STARTED.  SKIPPING
C       THEM AND CARRYING ON MADE "TASK 5 /M 200 /I" COLLECT 5,2,0,0 AND
C       RETURN OCTAL 5200 = 2688 AS THE TASK ID.  EVERY COMMAND WITH ONE
C       NUMBER ON IT HID THIS.
        IVAL = 0
        INN = 0
        DO 20 I=1,NARG
          IF (ARG(I) .LT. ZERO) GO TO 10
          IF (ARG(I) .GT. NINE) GO TO 10
          D = ARG(I) - ZERO
          IF (D .GE. IRADIX) GO TO 10
          IVAL = IVAL * IRADIX + D
          INN = 1
          GO TO 20
10        IF (INN .NE. 0) RETURN
20      CONTINUE
        RETURN
        END
C
C
C****** OBJECT MODULE READER AND LOAD MODULE EMITTER ******************
C
C       APO OBJECT FORMAT, LNK100 MANUAL CHAPTER 3.  ALL NUMBERS OCTAL.
C       A BLOCK HEADER IS ANY LINE CONTAINING "***"; THE FIRST NUMBER ON
C       IT IS THE BLOCK TYPE AND THE SECOND, WHERE PRESENT, IS THE COUNT
C       OF DATA RECORDS THAT FOLLOW.
C
C         6  ***LSB      1  ***END       3  ***TITLE
C         4 C ***ENTRY   5 C ***EXT     13 C ***AENTRY
C         0 C L ***CODE  7  ***LEB      12 C ***FPB
C
C       ONLY RELOCATION TYPE 5, EXTERNAL REFERENCE, IS PROCESSED -- SAID
C       TWICE IN SECTION 3.2.  IT PATCHES THE LOW 16 BITS OF THE 64-BIT
C       WORD, WHICH IS THE VALUE FIELD (BITS 48-63), I.E. CODE WORD 4.
C
        SUBROUTINE LODFIL (LUN)
C
        INTEGER LUN
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        COMMON /FIXCOM/ FIXWRD(600),FIXSYM(600),NFIX                    LODCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LODCOM
        LOGICAL*1 LINE(80),NBUF(80)
        INTEGER V(16),NV,BTYPE,ICNT,IL,I,J,K,IDX
        INTEGER NAME(3),MODBAS,NEXTRA,EXTNAM(3,40),NEXT,FIXBAS
        INTEGER ENTIDX(60),NENT
        INTEGER STAR3
C
        MODBAS = NEXTLC
        NEXT = 0
        NENT = 0
        FIXBAS = NFIX
C
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
10      READ (LUN,900,END=800) LINE
900     FORMAT (80A1)
        CALL STARS (LINE,STAR3)
        IF (STAR3 .EQ. 0) GO TO 10
        CALL GETNUM (LINE,STAR3-1,V,NV,16)
        IF (NV .LE. 0) GO TO 10
        BTYPE = V(1)
        ICNT = 0
        IL = 0
        IF (NV .GE. 2) ICNT = V(2)
        IF (NV .GE. 3) IL = V(3)
C
        IF (BTYPE .EQ. 3) GO TO 100
        IF (BTYPE .EQ. 4) GO TO 200
        IF (BTYPE .EQ. 5) GO TO 300
        IF (BTYPE .EQ. 0) GO TO 400
        IF (BTYPE .EQ. 1) GO TO 500
C       AENTRY IS BLOCK TYPE 13 **OCTAL** = 11 DECIMAL.  THE MANUAL
C       GIVES EVERY BLOCK TYPE IN OCTAL (SECTION 3.1: "THE OCTAL BLOCK
C       TYPE NUMBER IS IN PARENTHESES") AND GETNUM PARSES OCTAL, SO A
C       DECIMAL 13 HERE NEVER MATCHES AND EVERY AENTRY BLOCK IS SKIPPED
C       -- WHICH LEAVES ITS SYMBOLS UNDEFINED.  TYPES 0,1,3,4,5,6,7 READ
C       THE SAME IN BOTH BASES, WHICH IS WHY ONLY THIS ONE BIT.
        IF (BTYPE .EQ. 11) GO TO 200
        IF (BTYPE .EQ. 6) GO TO 10
        IF (BTYPE .EQ. 7) GO TO 800
C       ANY OTHER BLOCK (FPB, DBDB, DBIB) IS SKIPPED WITH ITS RECORDS.
        IF (ICNT .LE. 0) GO TO 10
        DO 20 I=1,ICNT
          READ (LUN,900,END=800) LINE
20      CONTINUE
        GO TO 10
C
C------ TITLE: THE MODULE NAME IS ON THE FOLLOWING LINE.
100     READ (LUN,900,END=800) LINE
        CALL PACK6 (LINE,1,NAME)
        LODCNT = LODCNT + 1
        IF (FIRSTE(1) .NE. 0) GO TO 10
        FIRSTE(1) = NAME(1)
        FIRSTE(2) = NAME(2)
        FIRSTE(3) = NAME(3)
        GO TO 10
C
C------ ENTRY / AENTRY: NAME VALUE TYPE PARAMNUM.  THE VALUE IS RELATIVE
C       TO THE START OF THE ROUTINE, SO ADD THE MODULE BASE.
200     IF (ICNT .LE. 0) GO TO 10
        DO 210 I=1,ICNT
          READ (LUN,900,END=800) LINE
          CALL PACK6 (LINE,1,NAME)
C
C         PARSE THE NUMBERS FROM COLUMN 7.  THE NAME OCCUPIES COLUMNS
C         1-6 AND MAY CONTAIN DIGITS -- FUN1, ADV2, XFFT4, SET24B,
C         VINDX2, TRED2 AND IMTQL2 ALL DO -- AND GETNUM OVER THE WHOLE
C         LINE TAKES THOSE FOR THE ADDRESS.  THE SYMBOL THEN RESOLVES
C         TO MODBAS PLUS THE DIGITS IN ITS OWN NAME: FUN1 THROUGH FUN4
C         CAME OUT ONE TO FOUR HIGH, AND SET24B TWENTY HIGH.
C
          DO 201 J=1,74
            NBUF(J) = LINE(J+6)
201       CONTINUE
          CALL GETNUM (NBUF,74,V,NV,16)
          CALL SYMLU (NAME,IDX,1)
          IF (IDX .LE. 0) GO TO 210
          IF (SYMFLG(IDX) .NE. 0) GO TO 205
          NUNDEF = NUNDEF - 1
205       SYMFLG(IDX) = 1
          SYMSEG(IDX) = CUROV
          SYMVAL(IDX) = MODBAS
          IF (NV .GE. 1) SYMVAL(IDX) = MODBAS + V(1)
          IF (NENT .GE. 60) GO TO 209
          NENT = NENT + 1
          ENTIDX(NENT) = IDX
209       CONTINUE
210     CONTINUE
        GO TO 10
C
C------ EXT: A LIST OF NAMES.  THE RELOCATION ARG IS A ONE-BASED INDEX
C       INTO THIS LIST, SO THE ORDER MATTERS.
300     IF (ICNT .LE. 0) GO TO 10
        DO 310 I=1,ICNT
          READ (LUN,900,END=800) LINE
          CALL PACK6 (LINE,1,NAME)
          IF (NEXT .GE. 40) GO TO 310
          NEXT = NEXT + 1
          EXTNAM(1,NEXT) = NAME(1)
          EXTNAM(2,NEXT) = NAME(2)
          EXTNAM(3,NEXT) = NAME(3)
          CALL SYMLU (NAME,IDX,1)
310     CONTINUE
C
C       TURN THIS MODULE'S PENDING EXT INDICES INTO SYMBOL INDICES.
C
        IF (NFIX .LE. FIXBAS) GO TO 10
        DO 320 I=FIXBAS+1,NFIX
          IDX = -FIXSYM(I)
          IF (IDX .LT. 1) GO TO 320
          IF (IDX .GT. NEXT) GO TO 320
          NAME(1) = EXTNAM(1,IDX)
          NAME(2) = EXTNAM(2,IDX)
          NAME(3) = EXTNAM(3,IDX)
          CALL SYMLU (NAME,J,1)
          FIXSYM(I) = J
320     CONTINUE
        GO TO 10
C
C------ CODE: ICNT DATA RECORDS OF FOUR OCTAL WORDS, EACH OPTIONALLY
C       FOLLOWED BY (FLDDES,TYPE,ARG) TRIPLES.
400     IF (ICNT .LE. 0) GO TO 10
        DO 450 I=1,ICNT
          READ (LUN,900,END=800) LINE
          CALL GETNUM (LINE,80,V,NV,16)
          IF (NV .LT. 4) GO TO 450
          IF (NCODE .GE. 1200) GO TO 440
          NCODE = NCODE + 1
          DO 410 J=1,4
            CODE(J,NCODE) = V(J)
410       CONTINUE
C         RELOCATION TRIPLES START AT FIELD 5.
          K = 5
420       IF (K+2 .GT. NV) GO TO 445
          IF (V(K+1) .NE. 5) GO TO 430
          IDX = V(K+2)
          IF (IDX .LT. 1) GO TO 430
C         RECORD THE RAW EXT INDEX, NOT A SYMBOL.  THE ***EXT BLOCK
C         COMES AFTER ***CODE IN THE FILE (MANUAL SECTION 3.1 GIVES THE
C         ORDER AS TITLE, AENTRY, ENTRY, CODE, EXT, END), SO THE NAME
C         THIS INDEX SELECTS IS NOT KNOWN YET.  THE EXT HANDLER TURNS
C         THESE INTO SYMBOL TABLE INDICES; EMTFIL THEN APPLIES THEM,
C         WHICH IS WHAT THE MANUAL MEANS BY THE E OR A COMMAND
C         "FREEZING" THE LINKS (SECTION 2.10).
          IF (NFIX .GE. 600) GO TO 428
          NFIX = NFIX + 1
          FIXWRD(NFIX) = NCODE
          FIXSYM(NFIX) = -IDX
428       CONTINUE
430       K = K + 3
          GO TO 420
440       WRITE (ITTO,910)
910       FORMAT (' PROGRAM STORE OVERFLOW')
445       CONTINUE
450     CONTINUE
        NEXTLC = NEXTLC + ICNT
        IF (NEXTLC .GT. HIGH) HIGH = NEXTLC - 1
        GO TO 10
C
C------ END: CONSUMES THE TRAILING NAME LINE, THEN THE NEXT MODULE MAY
C       FOLLOW IN THE SAME FILE (A LIBRARY).
500     READ (LUN,900,END=800) LINE
C
C       A MODULE WITH NO ***CODE OCCUPIES NO PROGRAM STORE AND ITS
C       ***ENTRY VALUES ARE ABSOLUTE -- SYMLIB IS 66 SUCH MODULES OF
C       PURE $EQU.  TAKE MODBAS BACK OFF AND FLAG THEM 2, SO LINKUP
C       DOES NOT SHIFT THEM WITH THE SEGMENT EITHER.
C
        IF (NEXTLC .NE. MODBAS) GO TO 510
        IF (NENT .LE. 0) GO TO 510
        DO 505 I=1,NENT
          SYMVAL(ENTIDX(I)) = SYMVAL(ENTIDX(I)) - MODBAS
          SYMFLG(ENTIDX(I)) = 2
505     CONTINUE
510     CONTINUE
        MODBAS = NEXTLC
        NEXT = 0
        NENT = 0
        FIXBAS = NFIX
        GO TO 10
C
800     RETURN
        END
C
C
C****** STARS = LOCATE "***" IN A LINE, 0 IF ABSENT *******************
C
        SUBROUTINE STARS (LINE,IPOS)
        LOGICAL*1 LINE(80),AST
        INTEGER IPOS,I
        DATA AST/'*'/
        IPOS = 0
        DO 10 I=1,78
          IF (LINE(I) .NE. AST) GO TO 10
          IF (LINE(I+1) .NE. AST) GO TO 10
          IF (LINE(I+2) .NE. AST) GO TO 10
          IPOS = I
          RETURN
10      CONTINUE
        RETURN
        END
C
C
C****** GETNUM = EXTRACT OCTAL NUMBERS FROM A LINE *******************
C
C       A LEADING "*" ON A CODE RECORD MARKS RELOCATION AND IS SKIPPED.
C
        SUBROUTINE GETNUM (LINE,NCH,V,NV,MAXV)
        LOGICAL*1 LINE(80),BL,AST,ZERO,SEVEN
        INTEGER NCH,V(16),NV,MAXV,I,D,ACC,INNUM
        DATA BL/' '/,AST/'*'/,ZERO/'0'/,SEVEN/'7'/
        NV = 0
        INNUM = 0
        ACC = 0
        DO 30 I=1,NCH
          IF (LINE(I) .EQ. AST) GO TO 30
          IF (LINE(I) .LT. ZERO) GO TO 20
          IF (LINE(I) .GT. SEVEN) GO TO 20
          D = LINE(I) - ZERO
C         A 16-BIT OCTAL FIELD RUNS TO 177777, WHICH DOES NOT FIT A
C         SIGNED INTEGER*2 -- THE PLAIN ACC*8+D TRAPS WITH "INTEGER
C         OVERFLOW" ON THE LAST DIGIT.  FOLD THE TOP BIT IN BY HAND:
C         (ACC-4096)*8+D-32768 IS THE TWO'S COMPLEMENT OF THE VALUE WE
C         WANT AND EVERY INTERMEDIATE STAYS IN RANGE.
          IF (ACC .GE. 4096) GO TO 12
          ACC = ACC * 8 + D
          GO TO 14
C         32768 IS NOT A VALID INTEGER*2 LITERAL, SO SUBTRACT IT IN TWO
C         STEPS; EVERY INTERMEDIATE THEN STAYS IN RANGE.
12        ACC = ACC - 4096
          ACC = ACC * 8 + D
          ACC = ACC - 32767
          ACC = ACC - 1
14        INNUM = 1
          GO TO 30
20        IF (INNUM .EQ. 0) GO TO 30
          IF (NV .GE. MAXV) GO TO 25
          NV = NV + 1
          V(NV) = ACC
25        ACC = 0
          INNUM = 0
30      CONTINUE
        IF (INNUM .EQ. 0) RETURN
        IF (NV .GE. MAXV) RETURN
        NV = NV + 1
        V(NV) = ACC
        RETURN
        END
C
C
C****** PACK6 = PACK SIX CHARACTERS INTO THREE WORDS *****************
C
        SUBROUTINE PACK6 (LINE,IST,NAME)
        LOGICAL*1 LINE(80)
        INTEGER IST,NAME(3),I,J,K,C1,C2
        DO 20 I=1,3
          J = IST + 2*I - 2
          K = J + 1
          C1 = LINE(J)
          C2 = LINE(K)
          IF (C1 .LT. 0) C1 = C1 + 256
          IF (C2 .LT. 0) C2 = C2 + 256
          NAME(I) = C1 + C2*256
20      CONTINUE
        RETURN
        END
C
C
C
C
C****** SYMLU = SYMBOL TABLE LOOKUP AND INSERT ************************
C
        SUBROUTINE SYMLU (NAME,IDX,MODE)
C
C       MODE 0 = LOOK UP ONLY, IDX=0 IF ABSENT
C       MODE 1 = LOOK UP, INSERTING AS UNDEFINED IF ABSENT
C
        INTEGER NAME(3),IDX,MODE
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        COMMON /FIXCOM/ FIXWRD(600),FIXSYM(600),NFIX                    LODCOM
        INTEGER FIXWRD,FIXSYM,NFIX                                      LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
C
        INTEGER I,IVIS
C
C       AN OVERLAID JOB SCOPES SYMBOLS BY SEGMENT.  A SEGMENT IS
C       CO-RESIDENT WITH ITS PARENT CHAIN, SO IT MAY SEE SYMBOLS
C       DEFINED THERE AND IN THE ROOT, BUT SIBLINGS OCCUPY THE SAME
C       PROGRAM STORE AND MUST NOT SEE EACH OTHER'S.  WITHOUT THIS A
C       NAME USED BY TWO LIBRARIES IN DIFFERENT SEGMENTS RESOLVES TO
C       WHICHEVER WAS LOADED LAST.
C
        IDX = 0
        IF (NSYM .LE. 0) GO TO 30
        DO 20 I=1,NSYM
          IF (SYMNAM(1,I) .NE. NAME(1)) GO TO 20
          IF (SYMNAM(2,I) .NE. NAME(2)) GO TO 20
          IF (SYMNAM(3,I) .NE. NAME(3)) GO TO 20
          CALL OVVIS (SYMSEG(I),IVIS)
          IF (IVIS .EQ. 0) GO TO 20
          IDX = I
          RETURN
20      CONTINUE
30      IF (MODE .EQ. 0) RETURN
        IF (NSYM .GE. 400) GO TO 80
        NSYM = NSYM + 1
        SYMNAM(1,NSYM) = NAME(1)
        SYMNAM(2,NSYM) = NAME(2)
        SYMNAM(3,NSYM) = NAME(3)
        SYMVAL(NSYM) = 0
        SYMFLG(NSYM) = 0
        SYMSEG(NSYM) = CUROV
        NUNDEF = NUNDEF + 1
        IDX = NSYM
        RETURN
80      WRITE (ITTO,1000)
1000    FORMAT (' SYMBOL TABLE OVERFLOW')
        RETURN
        END
C
C
C
C
C****** TREE = DECLARE THE OVERLAY STRUCTURE = SECTION 2.3.8 *********
C
        SUBROUTINE TREE (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        LOGICAL*1 LPAR,RPAR,ZERO,NINE
        INTEGER I,D,ACC,INN,STACK(12),SP,LAST(12)
        DATA LPAR/'('/,RPAR/')'/,ZERO/'0'/,NINE/'9'/
C
C       A LEFT PARENTHESIS OPENS AN OVERLAY LEVEL AND A RIGHT
C       PARENTHESIS CLOSES IT; THE NUMBERS INSIDE A LEVEL NAME THE
C       SEGMENTS IT HOLDS.  SO
C            TREE ((1 (2) (3)) (4) (5))
C       MAKES 1, 4 AND 5 ROOTS AND 2, 3 SUBORDINATE TO 1.  SEGMENTS AT
C       THE SAME LEVEL UNDER THE SAME PARENT SHARE A PROGRAM SOURCE
C       ADDRESS AND SO EXCLUDE ONE ANOTHER.
C
        NOVL = 0
        SP = 0
        ACC = 0
        INN = 0
        DO 5 I=1,12
          STACK(I) = 0
          LAST(I) = 0
5       CONTINUE
        DO 60 I=1,NARG
          IF (ARG(I) .LT. ZERO) GO TO 20
          IF (ARG(I) .GT. NINE) GO TO 20
          D = ARG(I) - ZERO
          ACC = ACC*10 + D
          INN = 1
          GO TO 60
20        IF (INN .EQ. 0) GO TO 30
          CALL OVADD (ACC,STACK,SP,LAST)
          ACC = 0
          INN = 0
30        IF (ARG(I) .NE. LPAR) GO TO 40
          IF (SP .GE. 12) GO TO 60
          SP = SP + 1
          STACK(SP) = 0
          IF (SP .GT. 1) STACK(SP) = LAST(SP-1)
          LAST(SP) = 0
          GO TO 60
40        IF (ARG(I) .NE. RPAR) GO TO 60
          IF (SP .LE. 0) GO TO 60
          SP = SP - 1
60      CONTINUE
        IF (INN .NE. 0) CALL OVADD (ACC,STACK,SP,LAST)
        WRITE (ITTO,1000) NOVL
1000    FORMAT (1X,I4,' OVERLAY SEGMENTS')
        RETURN
        END
C
C
        SUBROUTINE OVADD (NUM,STACK,SP,LAST)
        INTEGER NUM,STACK(12),SP,LAST(12)
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        IF (NOVL .GE. 24) RETURN
        NOVL = NOVL + 1
        OVNUM(NOVL) = NUM
        OVPAR(NOVL) = 0
        IF (SP .GT. 0) OVPAR(NOVL) = STACK(SP)
        OVPS(NOVL) = 0
        OVLN(NOVL) = 0
        OVMD(NOVL) = 0
        OVTSK(NOVL) = 0
        OVPRT(NOVL) = 0
        OVNPR(NOVL) = 0
        OVBEG(NOVL) = 0
        IF (SP .GT. 0) LAST(SP) = NUM
        RETURN
        END
C
C
C****** OVLY = SELECT AN OVERLAY SEGMENT = SECTION 2.3.9 *************
C
        SUBROUTINE OVLY (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER IV,I
C       EVERYTHING LOADED AFTER THIS COMMAND BELONGS TO SEGMENT IV, SO
C       THE SEGMENT IN PROGRESS IS CLOSED FIRST.
        CALL OVCLOS
        CALL NUMIN (ARG,NARG,IV)
        CUROV = 0
        DO 10 I=1,NOVL
          IF (OVNUM(I) .NE. IV) GO TO 10
          CUROV = I
          OVMARK = NCODE
          OVBEG(I) = NCODE + 1
          IF (NTSK .GT. 0) OVTSK(I) = TSKID(NTSK)
          RETURN
10      CONTINUE
        WRITE (ITTO,1000) IV
1000    FORMAT (' OVERLAY',I5,' NOT DECLARED IN TREE')
        RETURN
        END
C
C
        SUBROUTINE OVCLOS
        INTEGER CODE,NCODE                                              LODCOM
        COMMON /CODCOM/ CODE(4,1200),NCODE                              LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
C       THE SEGMENT SPANS THE CODE LOADED SINCE IT WAS SELECTED.
        IF (CUROV .LE. 0) RETURN
        OVLN(CUROV) = NCODE - OVMARK
        CUROV = 0
        RETURN
        END
C
C
C****** TASKY = DECLARE A SUPERVISOR TASK = SECTION 2.3.7 ************
C
        SUBROUTINE TASKY (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER IV
        IF (NTSK .LT. 8) GO TO 10
        WRITE (ITTO,1000)
1000    FORMAT (' TOO MANY TASKS')
        RETURN
10      CALL NUMIN (ARG,NARG,IV)
        NTSK = NTSK + 1
        TSKID(NTSK) = IV
C       TASK IDN </M> <PRIORITY> </I> </S> -- THE SECOND NUMBER IS THE
C       PRIORITY.  MANUAL 2.9: RPRI AND DPRI COME FROM THE PRI COMMAND
C       IF GIVEN, ELSE $TASK, ELSE THE TASK COMMAND.
        CALL NUM2 (ARG,NARG,IV)
        TSKPRI(NTSK) = 100
        IF (IV .GT. 0) TSKPRI(NTSK) = IV
        CALL TSKOPS (ARG,NARG,NTSK)
        RETURN
        END
C
C
        SUBROUTINE TSKOPS (ARG,NARG,K)
        LOGICAL*1 ARG(40)
        INTEGER NARG,K
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        LOGICAL*1 SL,LMM,LII,LSS
        INTEGER I,NM1
        DATA SL/'/'/,LMM/'M'/,LII/'I'/,LSS/'S'/
C       STATUS WORD BITS, SECTION 2.9.  A TASK IS SUSPENDED UNLESS
C       DECLARED /M (MAIN); /S MARKS IT SWAPPABLE; /I PUTS IT AT THE
C       HEAD OF THE READY QUEUE.
C       004000 UNLESS /M, 010000 IF /S, 001000 WHEN A READY QUEUE IS
C       BUILT.  /I IS NOT A STATUS BIT: IT PLACES THE TASK AT THE FRONT
C       OF THE READY QUEUE, AHEAD OF THE HIGHEST PRIORITY TASK,
C       REGARDLESS OF ITS OWN PRIORITY.  IT IS KEPT IN TSKFRT.
        TSKOPT(K) = 2048
        TSKFRT(K) = 0
        NM1 = NARG - 1
        IF (NM1 .LT. 1) RETURN
        DO 20 I=1,NM1
          IF (ARG(I) .NE. SL) GO TO 20
          IF (ARG(I+1) .EQ. LMM) TSKOPT(K) = TSKOPT(K) - 2048
          IF (ARG(I+1) .EQ. LSS) TSKOPT(K) = TSKOPT(K) + 4096
          IF (ARG(I+1) .EQ. LII) TSKFRT(K) = 1
20      CONTINUE
        RETURN
        END
C
C
C****** APPRIO = OVERRIDE TASK PRIORITY = SECTION 2.3.6 **************
C
        SUBROUTINE APPRIO (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER IV
        IF (NTSK .LE. 0) RETURN
        CALL NUMIN (ARG,NARG,IV)
        IF (IV .GT. 0) TSKPRI(NTSK) = IV
        CALL TSKOPS (ARG,NARG,NTSK)
        RETURN
        END
C
C
C****** CALLS = DECLARE A ROUTINE HOST CALLABLE = SECTION 2.3.10 *****
C
        SUBROUTINE CALLS (ARG,NARG)
        LOGICAL*1 ARG(40)
        INTEGER NARG
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER NAME(3),IDX,I
        LOGICAL*1 PAD(8),BL
        DATA BL/' '/
C       NAMES AN ENTRY THE HOST MAY CALL.  LOD100 EMITS A HASI WRAPPER
C       FOR EACH; THE NAME IS RESOLVED HERE AND THE WRAPPER IS NOT YET
C       GENERATED.
        DO 10 I=1,8
          PAD(I) = BL
          IF (I .LE. NARG) PAD(I) = ARG(I)
10      CONTINUE
        CALL PACK6 (PAD,1,NAME)
        CALL SYMLU (NAME,IDX,1)
        WRITE (ITTO,1000)
1000    FORMAT (' HASI GENERATION NOT IMPLEMENTED')
        RETURN
        END
C
C
C****** LINKUP = ALLOCATE SEGMENTS AND PARTITIONS = SECTION 2.8 ******
C
        SUBROUTINE LINKUP
        INTEGER SYMNAM,SYMVAL,SYMFLG,NSYM,HIGH,BASE,NEXTLC,             LODCOM
     1  IRADIX,NUNDEF,FROZEN,LODCNT,FIRSTE,ITTI,ITTO,IOBJ,IOUT          LODCOM
        COMMON /LNKCOM/ SYMNAM(3,400),SYMVAL(400),SYMFLG(400),          LODCOM
     1  NSYM,HIGH,BASE,NEXTLC,IRADIX,NUNDEF,FROZEN,LODCNT,              LODCOM
     2  FIRSTE(3),ITTI,ITTO,IOBJ,IOUT                                   LODCOM
        INTEGER LMID,PSOFF,MDOFF,MODTSK,HASLUN                          LODCOM
        COMMON /LODCOM/ LMID,PSOFF,MDOFF,MODTSK,HASLUN                  LODCOM
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER I,J,K,NB,BND(25),E,S,NBM,I1
C
        CALL OVCLOS
        IF (NOVL .LE. 0) RETURN
C       A ROOT BEGINS AT THE PROGRAM SOURCE ORIGIN; A CHILD BEGINS
C       WHERE ITS PARENT ENDS.
        DO 20 I=1,NOVL
          IF (OVPAR(I) .NE. 0) GO TO 10
          OVPS(I) = PSOFF
          GO TO 20
10        DO 15 J=1,NOVL
            IF (OVNUM(J) .EQ. OVPAR(I)) OVPS(I) = OVPS(J) + OVLN(J)
15        CONTINUE
20      CONTINUE
C       PARTITION BOUNDARIES ARE THE DISTINCT SEGMENT ORIGINS, SORTED,
C       CLOSED BY THE HIGHEST SEGMENT END.
        NB = 0
        DO 40 I=1,NOVL
          DO 30 J=1,NB
            IF (BND(J) .EQ. OVPS(I)) GO TO 40
30        CONTINUE
          IF (NB .GE. 24) GO TO 40
          NB = NB + 1
          BND(NB) = OVPS(I)
40      CONTINUE
        IF (NB .LE. 1) GO TO 60
        NBM = NB - 1
        DO 55 I=1,NBM
          I1 = I + 1
          DO 50 J=I1,NB
            IF (BND(J) .GE. BND(I)) GO TO 50
            K = BND(I)
            BND(I) = BND(J)
            BND(J) = K
50        CONTINUE
55      CONTINUE
60      E = 0
        DO 65 I=1,NOVL
          S = OVPS(I) + OVLN(I)
          IF (S .GT. E) E = S
65      CONTINUE
        BND(NB+1) = E
C       A SEGMENT CLAIMS EVERY PARTITION ITS OWN RANGE OVERLAPS.
        DO 80 I=1,NOVL
          OVPRT(I) = 0
          OVNPR(I) = 0
          S = OVPS(I) + OVLN(I)
          DO 70 J=1,NB
            IF (BND(J) .GE. S) GO TO 70
            IF (BND(J+1) .LE. OVPS(I)) GO TO 70
            IF (OVPRT(I) .EQ. 0) OVPRT(I) = J
            OVNPR(I) = OVNPR(I) + 1
70        CONTINUE
80      CONTINUE
        PRTADR = NB
C
C       SEGMENT IMAGES OCCUPY MAIN DATA IN DECLARATION ORDER; THE
C       SUPERVISOR COPIES A SEGMENT FROM THERE INTO PROGRAM SOURCE WHEN
C       IT IS ENTERED (SECTION 2.8, APOVLD).
C
        K = MDOFF
        DO 85 I=1,NOVL
          OVMD(I) = K
          K = K + OVLN(I)*2
85      CONTINUE
        OVTADR = K
C
C       MODULES WERE LOADED SEQUENTIALLY, SO A SEGMENT SITS AT
C       PSOFF+OVBEG-1 AND MUST MOVE TO OVPS.  SIBLING ROOTS BOTH
C       RESTART AT PSOFF, SO THE SHIFT IS REAL, NOT COSMETIC.  BIAS
C       EVERY SYMBOL THE SEGMENT DEFINED BEFORE RELOCATIONS APPLY.
C
        DO 95 I=1,NOVL
          K = OVPS(I) - (PSOFF + OVBEG(I) - 1)
          IF (K .EQ. 0) GO TO 95
          DO 90 J=1,NSYM
            IF (SYMSEG(J) .NE. I) GO TO 90
            IF (SYMFLG(J) .EQ. 0) GO TO 90
            IF (SYMFLG(J) .EQ. 2) GO TO 90
            SYMVAL(J) = SYMVAL(J) + K
90        CONTINUE
95      CONTINUE
        RETURN
        END
C
C
C****** WRTBR = OVERLAY TABLE, PARTITION TABLE AND TCBS **************
C
        SUBROUTINE WRTBR
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER I,BAS,NENT
C
C       OVERLAY TABLE, TABLE 2-1 -- EIGHT MAIN DATA WORDS PER SEGMENT:
C         1 SEGMENT NUMBER    2 MAIN DATA ADDRESS   3 PS ADDRESS
C         4 LENGTH            5 TASK IDENTIFIER     6 STATUS
C         7 FIRST PARTITION   8 PARTITIONS REQUIRED
C       WORD 6 IS ZEROED: THE RESIDENCY BIT IS THE SUPERVISOR'S.
C
        IF (NOVL .LE. 0) RETURN
        NENT = NOVL * 8
        CALL PUTHDR (NENT*2,OVTADR,1)
        DO 30 I=1,NOVL
          CALL PUT32 (OVNUM(I))
          CALL PUT32 (OVMD(I))
          CALL PUT32 (OVPS(I))
          CALL PUT32 (OVLN(I))
          CALL PUT32 (OVTSK(I))
          CALL PUT32 (0)
          CALL PUT32 (OVTADR+NENT+OVPRT(I)-1)
          CALL PUT32 (OVNPR(I))
30      CONTINUE
C       PS PARTITION TABLE: ONE WORD PER PARTITION, ZEROED -- NOTHING
C       IS RESIDENT UNTIL THE SUPERVISOR LOADS IT.
        IF (PRTADR .LE. 0) GO TO 45
        CALL PUTHDR (PRTADR*2,OVTADR+NENT,1)
        DO 40 I=1,PRTADR
          CALL PUT32 (0)
40      CONTINUE
45      IF (NTSK .LE. 0) RETURN
C       ONE TASK CONTROL BLOCK PER TASK, 150 WORDS, TABLE 2-2.
        TCBADR = OVTADR + NENT + PRTADR
        BAS = TCBADR
        DO 80 I=1,NTSK
          CALL PUTHDR (300,BAS,1)
          CALL PUTTCB (I,BAS)
          BAS = BAS + 150
80      CONTINUE
        RETURN
        END
C
C
        SUBROUTINE PUTTCB (K,BAS)
        INTEGER K,BAS
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER I,J,FIRST,NSEG,RL,LL,IRQ,ISTAT
C
C       TCB FORMAT, TABLE 2-2, AND THE INITIALISATION LISTED AFTER IT:
C         1 RLINK   2 LLINK   3 RPRI    4 TYPE    5 LENGTH  6 ANSKEY
C         7 ID      8 OVLPTR  9 OVLCNT 10 DPRI   11 STATUS 12 LSTMSG
C        13 RCLOCK 14 LCLOCK 15 ICLOCK 16 TADDR
C        48 APSTAT3  49-64 SRS
C       "ALL OTHER ITEMS ARE INITIALIZED TO ZERO."
C
        FIRST = 0
        NSEG = 0
        DO 5 I=1,NOVL
          IF (OVTSK(I) .NE. TSKID(K)) GO TO 5
          NSEG = NSEG + 1
          IF (FIRST .EQ. 0) FIRST = I
5       CONTINUE
C       THE READY QUEUE EXISTS ONLY IF READYQ IS DEFINED (SECTION 2.10);
C       WITHOUT IT THERE IS NOTHING TO CHAIN AND THE LINKS STAY ZERO.
        CALL HASRQ (IRQ)
        RL = 0
        LL = 0
        IF (IRQ .NE. 0) CALL QLINK (K,RL,LL)
C       "WHEN READYQ IS DEFINED, LOD100 SETS THE READY QUEUE BIT IN
C       EACH TCB STATUS WORD" -- SO IT IS CONDITIONAL, NOT AUTOMATIC.
        ISTAT = TSKOPT(K)
        IF (IRQ .NE. 0) ISTAT = ISTAT + 512
        DO 10 I=1,150
          J = 0
          IF (I .EQ. 1)  J = RL
          IF (I .EQ. 2)  J = LL
          IF (I .EQ. 3)  J = TSKPRI(K)
          IF (I .EQ. 5)  J = 150
          IF (I .EQ. 7)  J = TSKID(K)
          IF (I .EQ. 8 .AND. FIRST .NE. 0) J = OVTADR + (FIRST-1)*8
          IF (I .EQ. 9)  J = NSEG
          IF (I .EQ. 10) J = TSKPRI(K)
          IF (I .EQ. 11) J = ISTAT
C         RCLOCK AND LCLOCK BOTH HOLD THE ADDRESS OF RCLOCK ITSELF.
          IF (I .EQ. 13) J = BAS + 12
          IF (I .EQ. 14) J = BAS + 12
          IF (I .EQ. 16 .AND. FIRST .NE. 0) J = OVMD(FIRST)
C         APSTAT3 IS SET TO 55260 OCTAL.
          IF (I .EQ. 48) J = 23216
C         SRS(0) IS THE TERMINATION ROUTINE, WHICH THIS LOADER DOES NOT
C         SUPPLY; SRS(1) IS THE TASK'S PROGRAM SOURCE ADDRESS.
          IF (I .EQ. 50 .AND. FIRST .NE. 0) J = OVPS(FIRST)
          CALL PUT32 (J)
10      CONTINUE
        RETURN
        END
C
C
        SUBROUTINE QLINK (K,RL,LL)
        INTEGER K,RL,LL
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER I,J,P,N,ORD(8),T
C
C       READY QUEUE, SECTION 2.10.  TASKS ARE CHAINED IN DESCENDING
C       PRIORITY, EACH TCB'S RLINK POINTING AT THE NEXT AND ITS LLINK
C       AT THE PREVIOUS.  /I TASKS GO AHEAD OF THE HIGHEST PRIORITY
C       TASK WHATEVER THEIR OWN PRIORITY.  THE HEAD AND TAIL LINK TO
C       READYQ, WHOSE ADDRESS THIS LOADER DOES NOT KNOW, SO THEY ARE
C       LEFT ZERO FOR APX100 TO PATCH.
C
        N = NTSK
        DO 10 I=1,N
          ORD(I) = I
10      CONTINUE
        IF (N .LE. 1) GO TO 40
        DO 30 I=1,N-1
          DO 20 J=I+1,N
            IF (TSKFRT(ORD(J)) .GT. TSKFRT(ORD(I))) GO TO 25
            IF (TSKFRT(ORD(J)) .LT. TSKFRT(ORD(I))) GO TO 20
            IF (TSKPRI(ORD(J)) .LE. TSKPRI(ORD(I))) GO TO 20
25          T = ORD(I)
            ORD(I) = ORD(J)
            ORD(J) = T
20        CONTINUE
30      CONTINUE
40      P = 0
        DO 50 I=1,N
          IF (ORD(I) .EQ. K) P = I
50      CONTINUE
        RL = 0
        LL = 0
        IF (P .LE. 0) RETURN
        IF (P .LT. N) RL = TCBADR + P*150
        IF (P .GT. 1) LL = TCBADR + (P-2)*150
        RETURN
        END
C
C
        SUBROUTINE PUTHDR (CNT,ADDR,DEST)
        INTEGER CNT,ADDR,DEST
        CALL EMITW (0)
        CALL EMITW (CNT)
        CALL EMITW (ADDR)
        CALL EMITW (0)
        CALL EMITW (DEST)
        CALL EMITW (0)
        CALL EMITW (0)
        CALL EMITW (0)
        RETURN
        END
C
C
        SUBROUTINE PUT32 (V)
        INTEGER V
C       FSLMLD CALLS APPUT(...,CNT*PAKFAC/2,...) FOR A MAIN DATA
C       DESTINATION, SO ONE AP WORD IS TWO HOST WORDS, HIGH FIRST.
        CALL EMITW (0)
        CALL EMITW (V)
        RETURN
        END
C
C
        SUBROUTINE OVVIS (SEG,IVIS)
        INTEGER SEG,IVIS
        INTEGER OVNUM,OVPAR,OVPS,OVLN,OVMD,OVTSK,OVPRT,OVNPR            LODCOM
        INTEGER NOVL,CUROV,TSKID,TSKPRI,TSKOPT,NTSK                     LODCOM
        INTEGER OVTADR,PRTADR,TCBADR,OVMARK,OVBEG,SYMSEG,TSKFRT         LODCOM
        COMMON /OVLCOM/ OVNUM(24),OVPAR(24),OVPS(24),OVLN(24),          LODCOM
     1  OVMD(24),OVTSK(24),OVPRT(24),OVNPR(24),NOVL,CUROV,              LODCOM
     2  TSKID(8),TSKPRI(8),TSKOPT(8),NTSK,OVTADR,PRTADR,TCBADR,         LODCOM
     3  OVMARK,OVBEG(24),SYMSEG(400),TSKFRT(8)                          LODCOM
        INTEGER K,P,N,J
C       VISIBLE IF DEFINED OUTSIDE ANY SEGMENT, OR IN THE CURRENT
C       SEGMENT OR ONE OF ITS ANCESTORS.
        IVIS = 1
        IF (SEG .EQ. 0) RETURN
        IF (NOVL .LE. 0) RETURN
        K = CUROV
        N = 0
10      IF (K .LE. 0) GO TO 100
        IF (K .EQ. SEG) RETURN
        N = N + 1
        IF (N .GT. 24) GO TO 100
        P = OVPAR(K)
        K = 0
        DO 20 J=1,NOVL
          IF (OVNUM(J) .EQ. P) K = J
20      CONTINUE
        GO TO 10
100     IVIS = 0
        RETURN
        END
C
C
        SUBROUTINE NUM2 (ARG,NARG,IV)
        LOGICAL*1 ARG(40)
        INTEGER NARG,IV
        LOGICAL*1 ZERO,NINE
        INTEGER I,D,ACC,SEEN,INN
        DATA ZERO/'0'/,NINE/'9'/
C       RETURNS THE SECOND RUN OF DIGITS ON THE LINE, ZERO IF ABSENT.
        IV = 0
        ACC = 0
        SEEN = 0
        INN = 0
        DO 20 I=1,NARG
          IF (ARG(I) .LT. ZERO) GO TO 10
          IF (ARG(I) .GT. NINE) GO TO 10
          D = ARG(I) - ZERO
          ACC = ACC*10 + D
          INN = 1
          GO TO 20
10        IF (INN .EQ. 0) GO TO 20
          SEEN = SEEN + 1
          IF (SEEN .EQ. 2) GO TO 30
          ACC = 0
          INN = 0
20      CONTINUE
        IF (INN .EQ. 0) RETURN
        SEEN = SEEN + 1
        IF (SEEN .NE. 2) RETURN
30      IV = ACC
        RETURN
        END
C
C
        SUBROUTINE HASRQ (IRQ)
        INTEGER IRQ
        INTEGER NAME(3),IDX
        LOGICAL*1 RQ(8)
        DATA RQ/'R','E','A','D','Y','Q',' ',' '/
C       THE READY QUEUE EXISTS ONLY IF A SYSTEM COMMON NAMED READYQ HAS
C       BEEN DEFINED TO SERVE AS ITS HEADER (SECTION 2.10).
        CALL PACK6 (RQ,1,NAME)
        CALL SYMLU (NAME,IDX,0)
        IRQ = 0
        IF (IDX .GT. 0) IRQ = 1
        RETURN
        END

